{% comment %}
  Collection Header Section
{% endcomment %}

<section style="background-color: #000000; padding: 80px 0 40px 0;">
  <div class="container-custom" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">

    <div class="text-center">
      <h1 class="text-white font-bold mb-6" style="font-size: clamp(2.5rem, 6vw, 5rem); font-family: 'Open Sans', sans-serif;">
        {{ collection.title | default: "All Provocations" }}
      </h1>

      {% if collection.description != blank %}
        <div class="text-white text-xl max-w-3xl mx-auto" style="opacity: 0.85; line-height: 1.7;">
          {{ collection.description }}
        </div>
      {% endif %}

      <div style="margin-top: 2rem; color: #ffffff; opacity: 0.6; font-size: 0.875rem;">
        {{ collection.products_count }}
        {% if collection.products_count == 1 %}
          product
        {% else %}
          products
        {% endif %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collection Header",
  "settings": []
}
{% endschema %}
