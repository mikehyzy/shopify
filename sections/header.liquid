{% comment %}
  Header Section - Black and White Only
{% endcomment %}

<header class="header fixed top-0 left-0 right-0 z-50 transition-all duration-300"
        style="background-color: #000000; border-bottom: 1px solid #333;"
        x-data="{
          mobileMenuOpen: false,
          cartCount: {{ cart.item_count }}
        }"
        role="banner">

  <div class="container-custom">
    <div class="flex items-center justify-between py-6">

      <!-- Logo -->
      <div class="logo flex-shrink-0">
        <a href="/" class="inline-block" aria-label="{{ shop.name }} Home">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 200 | image_tag:
               class: 'h-12 w-auto',
               alt: shop.name,
               loading: 'eager'
            }}
          {% else %}
            <span class="text-2xl font-heading font-bold text-white">
              {{ shop.name }}
            </span>
          {% endif %}
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8" role="navigation" aria-label="Main navigation">
        {% for link in linklists[section.settings.menu].links %}
          {% if link.links != blank %}
            <!-- Dropdown Menu -->
            <div class="relative group" x-data="{ open: false }" @mouseenter="open = true" @mouseleave="open = false">
              <button class="text-white font-heading text-sm uppercase tracking-wider hover:opacity-70 transition-opacity flex items-center"
                      @click="open = !open">
                {{ link.title }}
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div x-show="open"
                   x-transition
                   class="absolute top-full left-0 mt-2 py-2 w-48 bg-black border border-white/20 shadow-lg"
                   style="background-color: #000000;">
                {% for child_link in link.links %}
                  <a href="{{ child_link.url }}"
                     class="block px-4 py-2 text-white font-heading text-sm uppercase tracking-wider hover:bg-white/10 transition-colors {% if child_link.active %}font-bold{% endif %}"
                     {% if child_link.active %}aria-current="page"{% endif %}>
                    {{ child_link.title }}
                  </a>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <!-- Regular Link -->
            <a href="{{ link.url }}"
               class="text-white font-heading text-sm uppercase tracking-wider hover:opacity-70 transition-opacity {% if link.active %}font-bold{% endif %}"
               {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          {% endif %}
        {% endfor %}

        <!-- Cart Icon -->
        <a href="/cart"
           class="relative group"
           aria-label="Shopping cart">
          <svg class="w-6 h-6 text-white group-hover:opacity-70 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="absolute -top-2 -right-2 bg-white text-black text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center"
                  x-text="cartCount">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>

        <!-- Account/Login -->
        {% if shop.customer_accounts_enabled %}
          <a href="/account"
             class="text-white hover:opacity-70 transition-opacity"
             aria-label="{% if customer %}My Account{% else %}Login{% endif %}">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </a>
        {% endif %}
      </nav>

      <!-- Mobile Menu Button -->
      <button @click="mobileMenuOpen = !mobileMenuOpen"
              class="lg:hidden text-white p-2"
              aria-label="Toggle mobile menu"
              :aria-expanded="mobileMenuOpen">
        <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div x-show="mobileMenuOpen"
       x-transition
       class="lg:hidden fixed inset-0 bg-black z-40 pt-24"
       style="background-color: #000000;"
       @click.away="mobileMenuOpen = false">

    <nav class="container-custom py-8" role="navigation" aria-label="Mobile navigation">
      <ul class="space-y-6">
        {% for link in linklists[section.settings.menu].links %}
          <li>
            {% if link.links != blank %}
              <!-- Mobile Dropdown -->
              <div x-data="{ open: false }">
                <button @click="open = !open"
                        class="flex items-center justify-between w-full text-2xl font-heading text-white hover:opacity-70 transition-opacity {% if link.active %}font-bold{% endif %}">
                  <span>{{ link.title }}</span>
                  <svg class="w-6 h-6 transition-transform" :class="{ 'rotate-180': open }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <ul x-show="open" x-transition class="mt-4 ml-4 space-y-4">
                  {% for child_link in link.links %}
                    <li>
                      <a href="{{ child_link.url }}"
                         class="block text-xl font-heading text-white hover:opacity-70 transition-opacity {% if child_link.active %}font-bold{% endif %}"
                         {% if child_link.active %}aria-current="page"{% endif %}
                         @click="mobileMenuOpen = false">
                        {{ child_link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% else %}
              <!-- Regular Link -->
              <a href="{{ link.url }}"
                 class="block text-2xl font-heading text-white hover:opacity-70 transition-opacity {% if link.active %}font-bold{% endif %}"
                 {% if link.active %}aria-current="page"{% endif %}
                 @click="mobileMenuOpen = false">
                {{ link.title }}
              </a>
            {% endif %}
          </li>
        {% endfor %}

        <li class="pt-6 border-t border-white/20">
          <a href="/cart"
             class="flex items-center text-xl font-heading text-white hover:opacity-70 transition-opacity"
             @click="mobileMenuOpen = false">
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            Cart ({{ cart.item_count }})
          </a>
        </li>

        {% if shop.customer_accounts_enabled %}
          <li>
            <a href="/account"
               class="flex items-center text-xl font-heading text-white hover:opacity-70 transition-opacity"
               @click="mobileMenuOpen = false">
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              {% if customer %}My Account{% else %}Login{% endif %}
            </a>
          </li>
        {% endif %}
      </ul>
    </nav>
  </div>
</header>

<!-- Spacer to prevent content from hiding under fixed header -->
<div class="h-20"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
