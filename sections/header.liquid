{% comment %}
  Header Section with Navigation
  Features: Logo, main navigation, mobile menu, cart icon
{% endcomment %}

<header class="header fixed top-0 left-0 right-0 z-50 transition-all duration-300"
        x-data="{
          mobileMenuOpen: false,
          scrolled: false,
          cartCount: {{ cart.item_count }}
        }"
        x-init="
          window.addEventListener('scroll', () => {
            scrolled = window.scrollY > 50;
          });
        "
        :class="scrolled ? 'bg-midnight/95 backdrop-blur-md shadow-lg' : 'bg-transparent'"
        role="banner">

  <div class="container-custom">
    <div class="flex items-center justify-between py-6">

      <!-- Logo -->
      <div class="logo flex-shrink-0">
        <a href="/" class="inline-block" aria-label="Chicago Futures Salon Home">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 200 | image_tag:
               class: 'h-12 w-auto',
               alt: shop.name,
               loading: 'eager'
            }}
          {% else %}
            <span class="text-2xl font-heading font-bold gradient-text">
              Chicago Futures Salon
            </span>
          {% endif %}
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8" role="navigation" aria-label="Main navigation">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}"
             class="text-white font-heading text-sm uppercase tracking-wider hover:text-brass transition-colors animated-underline {% if link.active %}text-brass{% endif %}"
             {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {% endfor %}

        <!-- Cart Icon -->
        <a href="/cart"
           class="relative group"
           aria-label="Shopping cart with {{ cart.item_count }} items">
          <svg class="w-6 h-6 text-white group-hover:text-electric transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="absolute -top-2 -right-2 bg-brass text-midnight text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center"
                  x-text="cartCount">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>

        <!-- Account/Login -->
        {% if shop.customer_accounts_enabled %}
          <a href="/account"
             class="text-white hover:text-brass transition-colors"
             aria-label="{% if customer %}My Account{% else %}Login{% endif %}">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </a>
        {% endif %}
      </nav>

      <!-- Mobile Menu Button -->
      <button @click="mobileMenuOpen = !mobileMenuOpen"
              class="lg:hidden text-white p-2"
              aria-label="Toggle mobile menu"
              :aria-expanded="mobileMenuOpen">
        <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg x-show="mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div x-show="mobileMenuOpen"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 transform scale-95"
       x-transition:enter-end="opacity-100 transform scale-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100 transform scale-100"
       x-transition:leave-end="opacity-0 transform scale-95"
       class="lg:hidden fixed inset-0 bg-deep-blue/98 backdrop-blur-lg z-40 pt-24"
       @click.away="mobileMenuOpen = false">

    <nav class="container-custom py-8" role="navigation" aria-label="Mobile navigation">
      <ul class="space-y-6">
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a href="{{ link.url }}"
               class="block text-2xl font-heading text-white hover:text-brass transition-colors {% if link.active %}text-brass{% endif %}"
               {% if link.active %}aria-current="page"{% endif %}
               @click="mobileMenuOpen = false">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}

        <li class="pt-6 border-t border-chicago-grey/30">
          <a href="/cart"
             class="flex items-center text-xl font-heading text-white hover:text-electric transition-colors"
             @click="mobileMenuOpen = false">
            <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            Cart ({{ cart.item_count }})
          </a>
        </li>

        {% if shop.customer_accounts_enabled %}
          <li>
            <a href="/account"
               class="flex items-center text-xl font-heading text-white hover:text-brass transition-colors"
               @click="mobileMenuOpen = false">
              <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              {% if customer %}My Account{% else %}Login{% endif %}
            </a>
          </li>
        {% endif %}
      </ul>

      <!-- Mobile menu footer -->
      <div class="mt-12 pt-8 border-t border-chicago-grey/30">
        <p class="font-accent text-brass text-lg italic">
          "{{ section.settings.mobile_menu_quote | default: 'The marvelous is always beautiful' }}"
        </p>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer to prevent content from hiding under fixed header -->
<div class="h-20"></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "mobile_menu_quote",
      "label": "Mobile Menu Quote",
      "default": "The marvelous is always beautiful"
    }
  ]
}
{% endschema %}
