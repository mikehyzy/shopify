{% comment %}
  The Corporation Section - 501(c)(3) Information
{% endcomment %}

<section class="corporation-section section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="corporation">

  <div class="container-custom" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-white font-bold mb-6" style="font-size: clamp(2rem, 5vw, 4rem); font-family: 'Open Sans', sans-serif;">
        {{ section.settings.heading | default: "The Corporation" }}
      </h2>
      <p class="text-white text-lg max-w-4xl mx-auto" style="opacity: 0.85; line-height: 1.8;">
        {{ section.settings.intro | default: "For a group rooted in surrealist and situationist traditions, 'lawful activities' is doing a lot of heavy lifting in our Articles of Incorporation. Our lawyers assure us détournement is not yet a felony." }}
      </p>
    </div>

    <!-- Purpose Statement Block -->
    <div class="purpose-statement mb-20">
      <blockquote style="border-left: 4px solid #ffffff; padding-left: 2rem; margin: 0 auto; max-width: 900px; color: #ffffff; font-size: 1rem; line-height: 1.8; opacity: 0.9;">
        <p style="margin-bottom: 1rem;">
          <strong>(a)</strong> Advancing strategic foresight literacy by promoting the development and application of imaginative, scenario-based, and speculative methods to better understand and prepare for possible futures;
        </p>
        <p style="margin-bottom: 1rem;">
          <strong>(b)</strong> Developing and disseminating educational materials, tools, and frameworks to empower individuals, organizations, and communities to engage with long-term thinking, anticipatory awareness, and transformative change;
        </p>
        <p style="margin-bottom: 1rem;">
          <strong>(c)</strong> Conducting community events, salons, lectures, workshops, and other public programs designed to foster dialogue and experimentation around emerging trends, uncertainties, and alternative visions of the future;
        </p>
        <p style="margin-bottom: 1rem;">
          <strong>(d)</strong> Collaborating with academic institutions, research organizations, civic groups, and other educational or charitable entities to support scholarly inquiry, creative exploration, and practical applications of futures thinking;
        </p>
        <p style="margin-bottom: 0;">
          <strong>(e)</strong> Engaging in any and all lawful activities incidental to the foregoing purposes or that further the Corporation's exempt status under Section 501(c)(3) of the Internal Revenue Code.
        </p>
      </blockquote>
    </div>

    <!-- Leadership Grid -->
    <div class="leadership-section mb-20">
      <h3 class="text-white font-bold text-center mb-12" style="font-size: clamp(1.5rem, 3vw, 2.5rem); font-family: 'Open Sans', sans-serif; margin-bottom: 4rem;">
        Leadership
      </h3>
      <div class="leadership-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; justify-items: center; max-width: 1200px; margin: 0 auto 4rem auto;">

        <!-- President -->
        <div class="leader-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 2.5rem; width: 100%; max-width: 380px; text-align: center; transition: all 0.3s;">
          <h4 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">
            Mike Hyzy
          </h4>
          <p style="color: #ffffff; opacity: 0.7; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">
            President
          </p>

          <!-- Separator Line -->
          <div style="width: 60px; height: 2px; background-color: rgba(255, 255, 255, 0.3); margin: 0 auto 1.5rem auto;"></div>

          <!-- Fun Description -->
          <p style="color: #ffffff; opacity: 0.8; font-size: 0.95rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem;">
            "Someone has to sign the paperwork. The state of Illinois requires a name. He drew the short straw and now owns a title that would have gotten him expelled from every art movement we claim to descend from."
          </p>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/mikehyzy/"
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; color: #00d4ff; text-decoration: none; font-size: 0.875rem; transition: opacity 0.2s;"
             onmouseover="this.style.opacity='0.7'"
             onmouseout="this.style.opacity='1'">
            <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>

        <!-- Treasurer -->
        <div class="leader-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 2.5rem; width: 100%; max-width: 380px; text-align: center; transition: all 0.3s;">
          <h4 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">
            Michael Marshall
          </h4>
          <p style="color: #ffffff; opacity: 0.7; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">
            Treasurer
          </p>

          <!-- Separator Line -->
          <div style="width: 60px; height: 2px; background-color: rgba(255, 255, 255, 0.3); margin: 0 auto 1.5rem auto;"></div>

          <!-- Fun Description -->
          <p style="color: #ffffff; opacity: 0.8; font-size: 0.95rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem;">
            "Guards the money with the vigilance of a man who knows exactly how surrealists historically managed their finances. Poorly. That's how."
          </p>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/michaelmarshall/"
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; color: #00d4ff; text-decoration: none; font-size: 0.875rem; transition: opacity 0.2s;"
             onmouseover="this.style.opacity='0.7'"
             onmouseout="this.style.opacity='1'">
            <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>

        <!-- Secretary -->
        <div class="leader-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 2.5rem; width: 100%; max-width: 380px; text-align: center; transition: all 0.3s;">
          <h4 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">
            Anna Mulcahy
          </h4>
          <p style="color: #ffffff; opacity: 0.7; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">
            Secretary
          </p>

          <!-- Separator Line -->
          <div style="width: 60px; height: 2px; background-color: rgba(255, 255, 255, 0.3); margin: 0 auto 1.5rem auto;"></div>

          <!-- Fun Description -->
          <p style="color: #ffffff; opacity: 0.8; font-size: 0.95rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem;">
            "Keeper of the minutes. Which is generous, because nothing that happens at these salons should be committed to the permanent record."
          </p>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/annamulcahy/"
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; color: #00d4ff; text-decoration: none; font-size: 0.875rem; transition: opacity 0.2s;"
             onmouseover="this.style.opacity='0.7'"
             onmouseout="this.style.opacity='1'">
            <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>

      </div>
      <p class="text-center" style="color: #ffffff; opacity: 0.7; font-size: 0.95rem; max-width: 750px; margin: 0 auto; line-height: 1.8; padding-top: 2rem;">
        All terms run for two years. We are also forming a Members Council -- a rotating group of advisors who help shape our programs and ensure we stay weird, rigorous, and useful.
      </p>
    </div>

    <!-- Donation CTA -->
    <div class="donation-cta mb-20" style="border: 2px solid rgba(255, 255, 255, 0.3); background-color: #0a0a0a; padding: 3rem 2rem; text-align: center; max-width: 800px; margin: 0 auto 5rem auto;">
      <h3 class="text-white font-bold mb-4" style="font-size: clamp(1.5rem, 3vw, 2.5rem); font-family: 'Open Sans', sans-serif;">
        {{ section.settings.donation_heading | default: "Fund the Future" }}
      </h3>
      <p class="text-white mb-6" style="opacity: 0.85; font-size: 1rem; line-height: 1.8; max-width: 600px; margin: 0 auto 2rem auto;">
        {{ section.settings.donation_text | default: "Chicago Futures Salon is a federally recognized 501(c)(3) nonprofit organization. Your donation is tax-deductible to the fullest extent permitted by law. Every contribution helps us build a more imaginative, anticipatory, and resilient community." }}
      </p>
      <a href="{{ section.settings.donation_url | default: 'https://gofundme.com' }}"
         class="donate-btn"
         target="_blank"
         rel="noopener"
         style="display: inline-block; padding: 1rem 3rem; background-color: #ffffff; color: #000000; text-decoration: none; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; border: 2px solid #ffffff; transition: all 0.3s;">
        {{ section.settings.donation_button_text | default: "Donate" }}
      </a>
    </div>

    <!-- Social Links Strip -->
    <div class="social-links text-center">
      <p class="text-white mb-4" style="font-size: 1rem; opacity: 0.85;">
        {{ section.settings.social_heading | default: "Help us get the word out." }}
      </p>
      <div style="display: flex; gap: 1.5rem; justify-content: center; align-items: center; flex-wrap: wrap;">
        <a href="https://chicagofuturessalon.com"
           target="_blank"
           rel="noopener"
           class="social-link"
           style="color: #ffffff; text-decoration: none; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1.5rem; border: 1px solid rgba(255, 255, 255, 0.3); transition: all 0.3s;">
          chicagofuturessalon.com
        </a>
        <a href="{{ section.settings.linkedin_url | default: 'https://linkedin.com' }}"
           target="_blank"
           rel="noopener"
           class="social-link"
           style="color: #ffffff; text-decoration: none; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1.5rem; border: 1px solid rgba(255, 255, 255, 0.3); transition: all 0.3s; display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .leader-card:hover {
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-4px);
  }

  .donate-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .social-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .leadership-grid {
      grid-template-columns: 1fr !important;
      gap: 1.5rem;
    }

    .leader-card {
      max-width: 100% !important;
    }

    .donation-cta {
      padding: 2rem 1.5rem !important;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .leadership-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)) !important;
    }
  }
</style>

{% schema %}
{
  "name": "The Corporation",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "The Corporation"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro Text",
      "default": "For a group rooted in surrealist and situationist traditions, 'lawful activities' is doing a lot of heavy lifting in our Articles of Incorporation. Our lawyers assure us détournement is not yet a felony."
    },
    {
      "type": "text",
      "id": "donation_heading",
      "label": "Donation Heading",
      "default": "Fund the Future"
    },
    {
      "type": "textarea",
      "id": "donation_text",
      "label": "Donation Text",
      "default": "Chicago Futures Salon is a federally recognized 501(c)(3) nonprofit organization. Your donation is tax-deductible to the fullest extent permitted by law. Every contribution helps us build a more imaginative, anticipatory, and resilient community."
    },
    {
      "type": "text",
      "id": "donation_button_text",
      "label": "Donation Button Text",
      "default": "Donate"
    },
    {
      "type": "url",
      "id": "donation_url",
      "label": "Donation URL",
      "info": "Link to your GoFundMe or donation page"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social Links Heading",
      "default": "Help us get the word out."
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    }
  ],
  "presets": [
    {
      "name": "The Corporation"
    }
  ]
}
{% endschema %}
