{% comment %}
  The Corporation Section - 501(c)(3) Information
{% endcomment %}

<section class="corporation-section section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="corporation">

  <div class="container-custom" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-white font-bold mb-6" style="font-size: clamp(2rem, 5vw, 4rem); font-family: 'Open Sans', sans-serif;">
        {{ section.settings.heading | default: "The Corporation" }}
      </h2>
      <p class="text-white text-lg max-w-4xl mx-auto" style="opacity: 0.85; line-height: 1.8;">
        {{ section.settings.intro | default: "For a group rooted in surrealist and situationist traditions, 'lawful activities' is doing a lot of heavy lifting in our Articles of Incorporation. Our lawyers assure us détournement is not yet a felony." }}
      </p>
    </div>

    <!-- Purpose Statement Block -->
    <div class="purpose-statement mb-20">
      <blockquote style="border-left: 4px solid #ffffff; padding-left: 2rem; margin: 0 auto; max-width: 900px; color: #ffffff; font-size: 1rem; line-height: 1.8; opacity: 0.9;">
        <p style="margin-bottom: 1rem;">
          <strong>(a)</strong> Advancing strategic foresight literacy by promoting the development and application of imaginative, scenario-based, and speculative methods to better understand and prepare for possible futures;
        </p>
        <p style="margin-bottom: 1rem;">
          <strong>(b)</strong> Developing and disseminating educational materials, tools, and frameworks to empower individuals, organizations, and communities to engage with long-term thinking, anticipatory awareness, and transformative change;
        </p>
        <p style="margin-bottom: 1rem;">
          <strong>(c)</strong> Conducting community events, salons, lectures, workshops, and other public programs designed to foster dialogue and experimentation around emerging trends, uncertainties, and alternative visions of the future;
        </p>
        <p style="margin-bottom: 1rem;">
          <strong>(d)</strong> Collaborating with academic institutions, research organizations, civic groups, and other educational or charitable entities to support scholarly inquiry, creative exploration, and practical applications of futures thinking;
        </p>
        <p style="margin-bottom: 0;">
          <strong>(e)</strong> Engaging in any and all lawful activities incidental to the foregoing purposes or that further the Corporation's exempt status under Section 501(c)(3) of the Internal Revenue Code.
        </p>
      </blockquote>
    </div>

    <!-- Leadership Grid -->
    <div class="leadership-section mb-20" style="margin-top: 8rem;">
      <h3 class="text-white font-bold text-center mb-12" style="font-size: clamp(1.5rem, 3vw, 2.5rem); font-family: 'Open Sans', sans-serif; margin-bottom: 4rem;">
        Leadership
      </h3>
      <div class="leadership-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; justify-items: center; max-width: 1200px; margin: 0 auto 4rem auto;">

        <!-- President -->
        <div class="leader-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 2.5rem; width: 100%; max-width: 380px; text-align: center; transition: all 0.3s;">
          <h4 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">
            Mike Hyzy
          </h4>
          <p style="color: #ffffff; opacity: 0.7; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">
            President
          </p>

          <!-- Separator Line -->
          <div style="width: 60px; height: 2px; background-color: rgba(255, 255, 255, 0.3); margin: 0 auto 1.5rem auto;"></div>

          <!-- Fun Description -->
          <p style="color: #ffffff; opacity: 0.8; font-size: 0.95rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem;">
            "Someone has to sign the paperwork. The state of Illinois requires a name. He drew the short straw and now owns a title that would have gotten him expelled from every art movement we claim to descend from."
          </p>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/mikehyzy/"
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; color: #00d4ff; text-decoration: none; font-size: 0.875rem; transition: opacity 0.2s;"
             onmouseover="this.style.opacity='0.7'"
             onmouseout="this.style.opacity='1'">
            <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>

        <!-- Treasurer -->
        <div class="leader-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 2.5rem; width: 100%; max-width: 380px; text-align: center; transition: all 0.3s;">
          <h4 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">
            Michael Marshall
          </h4>
          <p style="color: #ffffff; opacity: 0.7; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">
            Treasurer
          </p>

          <!-- Separator Line -->
          <div style="width: 60px; height: 2px; background-color: rgba(255, 255, 255, 0.3); margin: 0 auto 1.5rem auto;"></div>

          <!-- Fun Description -->
          <p style="color: #ffffff; opacity: 0.8; font-size: 0.95rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem;">
            "Guards the money with the vigilance of a man who knows exactly how surrealists historically managed their finances. Artistically. That's how."
          </p>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/michaelmarshall888"
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; color: #00d4ff; text-decoration: none; font-size: 0.875rem; transition: opacity 0.2s;"
             onmouseover="this.style.opacity='0.7'"
             onmouseout="this.style.opacity='1'">
            <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>

        <!-- Secretary -->
        <div class="leader-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 2.5rem; width: 100%; max-width: 380px; text-align: center; transition: all 0.3s;">
          <h4 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem;">
            Anna Mulcahy
          </h4>
          <p style="color: #ffffff; opacity: 0.7; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">
            Secretary
          </p>

          <!-- Separator Line -->
          <div style="width: 60px; height: 2px; background-color: rgba(255, 255, 255, 0.3); margin: 0 auto 1.5rem auto;"></div>

          <!-- Fun Description -->
          <p style="color: #ffffff; opacity: 0.8; font-size: 0.95rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem;">
            "Keeper of the minutes. Which is generous, because nothing that happens at these salons should be committed to the permanent record."
          </p>

          <!-- LinkedIn Link -->
          <a href="https://www.linkedin.com/in/annamulcahy12"
             target="_blank"
             rel="noopener"
             style="display: inline-flex; align-items: center; gap: 0.5rem; color: #00d4ff; text-decoration: none; font-size: 0.875rem; transition: opacity 0.2s;"
             onmouseover="this.style.opacity='0.7'"
             onmouseout="this.style.opacity='1'">
            <svg style="width: 18px; height: 18px;" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>

      </div>

      <!-- Manifesto Accordion -->
      <div class="manifesto-accordion" style="max-width: 900px; margin: 4rem auto 0 auto;">
        <h4 class="text-center" style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.75rem; margin-bottom: 1rem;">
          Chicago Futures Salon Manifesto
        </h4>
        <p class="text-center" style="color: #ffffff; opacity: 0.7; font-size: 0.9rem; font-style: italic; margin-bottom: 2.5rem;">
          crafted at the intersection of Surrealist wonder, Situationist mischief, and Futurist propulsion
        </p>

        <!-- I. PURPOSE -->
        <details class="manifesto-section" style="border: 1px solid rgba(255, 255, 255, 0.2); margin-bottom: 1rem; background-color: #0a0a0a;">
          <summary style="padding: 1.5rem; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>I. PURPOSE</span>
            <span class="accordion-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div style="padding: 0 1.5rem 1.5rem 1.5rem; color: #ffffff; opacity: 0.85; line-height: 1.8;">
            <p>Chicago Futures Salon convenes an invitation‑only circle of senior corporate, academic, governmental, and artistic path‑finders who seek fresh vantage points on tomorrow. We value quality over quantity, depth over reach, depth over noise.</p>
          </div>
        </details>

        <!-- II. GROUND RULES -->
        <details class="manifesto-section" style="border: 1px solid rgba(255, 255, 255, 0.2); margin-bottom: 1rem; background-color: #0a0a0a;">
          <summary style="padding: 1.5rem; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>II. GROUND RULES OF THE SALON</span>
            <span class="accordion-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div style="padding: 0 1.5rem 1.5rem 1.5rem; color: #ffffff; opacity: 0.85; line-height: 1.8;">
            <p style="margin-bottom: 1rem;"><strong>1. Rarity</strong><br>Entry arrives by personal summons, extended with care, guarded with discretion.</p>
            <p style="margin-bottom: 1rem;"><strong>2. Plurality</strong><br>Voices diverge. Debate thrives. Every viewpoint earns space, curiosity, and rigorous challenge.</p>
            <p style="margin-bottom: 1rem;"><strong>3. Play</strong><br>Serious imagination flourishes through serious games. Expect Exquisite Corpses, one‑minute dream journals, semantic cut‑ups. Laughter lubricates insight.</p>
            <p style="margin-bottom: 1rem;"><strong>4. Drift</strong><br>Each gathering rewrites the map of thought. Guided dérives through concepts, disciplines, and provocations encourage minds to stroll past default routes.</p>
            <p style="margin-bottom: 1rem;"><strong>5. Remix</strong><br>We seize familiar symbols, invert them, and return them charged for action. Corporate jargon becomes poetic seed. Academic citations morph into speculative headlines.</p>
            <p style="margin-bottom: 0;"><strong>6. Velocity</strong><br>Conversation accelerates toward actionable prototypes, policies, or alliances. Visions take first breath before the session ends.</p>
          </div>
        </details>

        <!-- III. VALUES -->
        <details class="manifesto-section" style="border: 1px solid rgba(255, 255, 255, 0.2); margin-bottom: 1rem; background-color: #0a0a0a;">
          <summary style="padding: 1.5rem; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>III. VALUES</span>
            <span class="accordion-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div style="padding: 0 1.5rem 1.5rem 1.5rem; color: #ffffff; opacity: 0.85; overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
              <thead>
                <tr style="border-bottom: 2px solid rgba(255, 255, 255, 0.3);">
                  <th style="padding: 0.75rem; text-align: left; font-weight: 700;">Value</th>
                  <th style="padding: 0.75rem; text-align: left; font-weight: 700;">Surrealist Echo</th>
                  <th style="padding: 0.75rem; text-align: left; font-weight: 700;">Situationist Spark</th>
                  <th style="padding: 0.75rem; text-align: left; font-weight: 700;">Futurist Pulse</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                  <td style="padding: 0.75rem; font-weight: 600;">Marvel</td>
                  <td style="padding: 0.75rem;">Seek the uncanny in the everyday.</td>
                  <td style="padding: 0.75rem;">Defamiliarize the city of ideas.</td>
                  <td style="padding: 0.75rem;">Reveal latent futures hiding in plain sight.</td>
                </tr>
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                  <td style="padding: 0.75rem; font-weight: 600;">Liberation</td>
                  <td style="padding: 0.75rem;">Free the subconscious.</td>
                  <td style="padding: 0.75rem;">Escape the Spectacle.</td>
                  <td style="padding: 0.75rem;">Unshackle strategy from legacy trajectories.</td>
                </tr>
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                  <td style="padding: 0.75rem; font-weight: 600;">Provocation</td>
                  <td style="padding: 0.75rem;">Court contradiction.</td>
                  <td style="padding: 0.75rem;">Engineer situations that disrupt passivity.</td>
                  <td style="padding: 0.75rem;">Jolt leaders awake to wildcard possibilities.</td>
                </tr>
                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                  <td style="padding: 0.75rem; font-weight: 600;">Co‑creation</td>
                  <td style="padding: 0.75rem;">Collective automatism.</td>
                  <td style="padding: 0.75rem;">Group dérive.</td>
                  <td style="padding: 0.75rem;">Multi‑stakeholder scenario building.</td>
                </tr>
                <tr>
                  <td style="padding: 0.75rem; font-weight: 600;">Momentum</td>
                  <td style="padding: 0.75rem;">Dreams in motion.</td>
                  <td style="padding: 0.75rem;">Action in the streets of thought.</td>
                  <td style="padding: 0.75rem;">Rapid iteration toward preferred futures.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </details>

        <!-- IV. SALON CODE -->
        <details class="manifesto-section" style="border: 1px solid rgba(255, 255, 255, 0.2); margin-bottom: 1rem; background-color: #0a0a0a;">
          <summary style="padding: 1.5rem; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>IV. SALON CODE</span>
            <span class="accordion-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div style="padding: 0 1.5rem 1.5rem 1.5rem; color: #ffffff; opacity: 0.85; line-height: 1.8;">
            <ul style="list-style: none; padding-left: 0;">
              <li style="margin-bottom: 0.75rem; padding-left: 1.5rem; position: relative;">
                <span style="position: absolute; left: 0; color: #00d4ff;">•</span>
                Admit uncertainty with pride.
              </li>
              <li style="margin-bottom: 0.75rem; padding-left: 1.5rem; position: relative;">
                <span style="position: absolute; left: 0; color: #00d4ff;">•</span>
                Speak in images as often as in metrics.
              </li>
              <li style="margin-bottom: 0.75rem; padding-left: 1.5rem; position: relative;">
                <span style="position: absolute; left: 0; color: #00d4ff;">•</span>
                Trade expertise for curiosity when the two clash.
              </li>
              <li style="margin-bottom: 0.75rem; padding-left: 1.5rem; position: relative;">
                <span style="position: absolute; left: 0; color: #00d4ff;">•</span>
                Question every "given" at least once.
              </li>
              <li style="margin-bottom: 0; padding-left: 1.5rem; position: relative;">
                <span style="position: absolute; left: 0; color: #00d4ff;">•</span>
                Leave with a prototype, a pact, or a paradigm shift.
              </li>
            </ul>
          </div>
        </details>

        <!-- V. RITES OF GATHERING -->
        <details class="manifesto-section" style="border: 1px solid rgba(255, 255, 255, 0.2); margin-bottom: 1rem; background-color: #0a0a0a;">
          <summary style="padding: 1.5rem; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>V. RITES OF GATHERING</span>
            <span class="accordion-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div style="padding: 0 1.5rem 1.5rem 1.5rem; color: #ffffff; opacity: 0.85; line-height: 1.8;">
            <p style="margin-bottom: 1rem;"><strong>1. Threshold Ritual</strong><br>Guests receive a random prompt card on arrival. The prompt guides their mindset for the evening.</p>
            <p style="margin-bottom: 1rem;"><strong>2. Mirror Break</strong><br>A short automatic writing sprint surfaces hidden assumptions which the group then fragments and reassembles.</p>
            <p style="margin-bottom: 1rem;"><strong>3. Parallax Drift</strong><br>Teams conduct a structured wander through a conceptual landscape—markets, technologies, human desires—marking emotional highs and lows on a shared canvas.</p>
            <p style="margin-bottom: 1rem;"><strong>4. Future Flash</strong><br>Rapid design fiction sketches bring one audacious scenario to life within twenty minutes.</p>
            <p style="margin-bottom: 0;"><strong>5. Synthesis Circle</strong><br>Final round captures insights, commitments, and next moves. No idea leaves homeless.</p>
          </div>
        </details>

        <!-- VI. VISION -->
        <details class="manifesto-section" style="border: 1px solid rgba(255, 255, 255, 0.2); margin-bottom: 1rem; background-color: #0a0a0a;">
          <summary style="padding: 1.5rem; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.1rem; color: #ffffff; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center;">
            <span>VI. VISION</span>
            <span class="accordion-icon" style="transition: transform 0.3s;">▼</span>
          </summary>
          <div style="padding: 0 1.5rem 1.5rem 1.5rem; color: #ffffff; opacity: 0.85; line-height: 1.8;">
            <p style="margin-bottom: 1rem;">Chicago Futures Salon aims to seed a league of leaders who think sideways, drift forward, and act with imaginative courage. Enterprises shaped by these leaders will cultivate cultures where bold futures emerge first as playful speculation, then as lived reality.</p>
            <p style="margin-bottom: 0; font-weight: 600; font-style: italic;">We gather. We drift. We unlock the marvelous.</p>
          </div>
        </details>

      </div>
    </div>

    <!-- Donation CTA -->
    <div class="donation-cta mb-20" style="border: 2px solid rgba(255, 255, 255, 0.3); background-color: #0a0a0a; padding: 3rem 2rem; text-align: center; max-width: 800px; margin: 0 auto 5rem auto;">
      <h3 class="text-white font-bold mb-4" style="font-size: clamp(1.5rem, 3vw, 2.5rem); font-family: 'Open Sans', sans-serif;">
        {{ section.settings.donation_heading | default: "Fund the Future" }}
      </h3>
      <p class="text-white mb-6" style="opacity: 0.85; font-size: 1rem; line-height: 1.8; max-width: 600px; margin: 0 auto 2rem auto;">
        {{ section.settings.donation_text | default: "Chicago Futures Salon is a federally recognized 501(c)(3) nonprofit organization. Your donation is tax-deductible to the fullest extent permitted by law. Every contribution helps us build a more imaginative, anticipatory, and resilient community." }}
      </p>
      <a href="{{ section.settings.donation_url | default: 'https://gofundme.com' }}"
         class="donate-btn"
         target="_blank"
         rel="noopener"
         style="display: inline-block; padding: 1rem 3rem; background-color: #ffffff; color: #000000; text-decoration: none; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; border: 2px solid #ffffff; transition: all 0.3s;">
        {{ section.settings.donation_button_text | default: "Donate" }}
      </a>
    </div>

    <!-- Social Links Strip -->
    <div class="social-links text-center">
      <p class="text-white mb-4" style="font-size: 1rem; opacity: 0.85;">
        {{ section.settings.social_heading | default: "Help us get the word out." }}
      </p>
      <div style="display: flex; gap: 1.5rem; justify-content: center; align-items: center; flex-wrap: wrap;">
        <a href="https://chicagofuturessalon.com"
           target="_blank"
           rel="noopener"
           class="social-link"
           style="color: #ffffff; text-decoration: none; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1.5rem; border: 1px solid rgba(255, 255, 255, 0.3); transition: all 0.3s;">
          chicagofuturessalon.com
        </a>
        <a href="{{ section.settings.linkedin_url | default: 'https://linkedin.com' }}"
           target="_blank"
           rel="noopener"
           class="social-link"
           style="color: #ffffff; text-decoration: none; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1.5rem; border: 1px solid rgba(255, 255, 255, 0.3); transition: all 0.3s; display: inline-flex; align-items: center; gap: 0.5rem;">
          <svg style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .leader-card:hover {
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-4px);
  }

  .donate-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .social-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* Manifesto Accordion */
  .manifesto-section summary {
    transition: background-color 0.2s;
  }

  .manifesto-section summary:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

