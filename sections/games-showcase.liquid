{% comment %}
  Games Showcase Section - Product Grid
{% endcomment %}

<section class="games-showcase section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="games">

  <div class="container-custom" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-white font-bold mb-6" style="font-size: clamp(2rem, 5vw, 4rem); font-family: 'Open Sans', sans-serif;">
        {{ section.settings.heading | default: "Future-Thinking Games" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-white text-xl max-w-3xl mx-auto" style="opacity: 0.85;">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Games Grid -->
    {% if section.settings.collection != blank %}
      {% assign collection = collections[section.settings.collection] %}

      {% if collection.products.size > 0 %}
        <div class="games-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
          {% for product in collection.products limit: section.settings.products_to_show %}
            <div class="product-card" style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; overflow: hidden; transition: all 0.3s;">

              <!-- Product Image -->
              {% if product.featured_image %}
                <a href="{{ product.url }}" style="display: block; overflow: hidden;">
                  <img src="{{ product.featured_image | image_url: width: 600 }}"
                       alt="{{ product.title | escape }}"
                       style="width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform 0.3s;"
                       loading="lazy"
                       class="product-image">
                </a>
              {% else %}
                <div style="width: 100%; aspect-ratio: 4/3; background-color: #1a1a1a; display: flex; align-items: center; justify-content: center;">
                  <svg style="width: 48px; height: 48px; opacity: 0.3;" fill="none" stroke="white" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              {% endif %}

              <!-- Product Info -->
              <div style="padding: 1.5rem;">
                <h3 style="font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 1.25rem; margin-bottom: 0.5rem;">
                  <a href="{{ product.url }}" style="color: #ffffff; text-decoration: none; transition: opacity 0.2s;">
                    {{ product.title }}
                  </a>
                </h3>

                {% if product.description != blank %}
                  <p style="color: #ffffff; opacity: 0.7; font-size: 0.875rem; line-height: 1.6; margin-bottom: 1rem;">
                    {{ product.description | strip_html | truncatewords: 20 }}
                  </p>
                {% endif %}

                <!-- Price and Button -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1rem;">
                  <span class="product-price" style="color: #ffffff; font-size: 1.5rem; font-weight: 700;">
                    {{ product.price | money }}
                  </span>
                  <a href="{{ product.url }}" class="product-btn" style="display: inline-block; padding: 0.75rem 1.5rem; background-color: #ffffff; color: #000000; text-decoration: none; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border: 2px solid #ffffff; transition: all 0.3s;">
                    View →
                  </a>
                </div>
              </div>

            </div>
          {% endfor %}
        </div>

        <!-- View All Button -->
        {% if section.settings.show_view_all and collection.products.size > section.settings.products_to_show %}
          <div style="text-align: center; margin-top: 3rem;">
            <a href="{{ collection.url }}" class="view-all-btn" style="display: inline-block; padding: 1rem 2.5rem; background-color: transparent; color: #ffffff; text-decoration: none; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.1em; border: 2px solid #ffffff; transition: all 0.3s;">
              View all Provocations
            </a>
          </div>
        {% endif %}

      {% else %}
        <div class="text-center py-12">
          <p class="text-white text-lg mb-4">
            No products in this collection yet.
          </p>
          <p style="color: #ffffff; opacity: 0.6;">
            Add products to the "{{ section.settings.collection }}" collection.
          </p>
        </div>
      {% endif %}

    {% else %}
      <!-- Default Sample Content -->
      <div class="games-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
        {% for i in (1..3) %}
          <div style="border: 1px solid rgba(255, 255, 255, 0.2); background-color: #0a0a0a; padding: 1.5rem;">
            <div style="width: 100%; aspect-ratio: 4/3; background-color: #1a1a1a; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
              <svg style="width: 48px; height: 48px; opacity: 0.3;" fill="none" stroke="white" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path>
              </svg>
            </div>
            <h3 style="font-family: 'Open Sans', sans-serif; color: #ffffff; font-weight: 700; font-size: 1.25rem; margin-bottom: 0.5rem;">
              Game Title {{ i }}
            </h3>
            <p style="color: #ffffff; opacity: 0.7; font-size: 0.875rem; margin-bottom: 1rem;">
              A futures-thinking card game for exploring possibilities.
            </p>
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="color: #ffffff; font-size: 1.5rem; font-weight: 700;">$29.00</span>
              <span style="color: #ffffff; opacity: 0.5; font-size: 0.75rem;">Sample Product</span>
            </div>
          </div>
        {% endfor %}
      </div>

      <p class="text-center" style="color: #ffffff; opacity: 0.5; margin-top: 2rem; font-size: 0.875rem;">
        Select a collection in the theme customizer to display your products
      </p>
    {% endif %}

  </div>
</section>

<style>
  .product-card:hover {
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-4px);
  }

  .product-card:hover .product-image {
    transform: scale(1.05);
  }

  .product-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .view-all-btn:hover {
    background-color: #ffffff;
    color: #000000;
  }
</style>

{% schema %}
{
  "name": "Games Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Future-Thinking Games"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our collection of card games designed to unlock futures thinking"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Games Showcase"
    }
  ]
}
{% endschema %}
