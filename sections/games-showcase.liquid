{% comment %}
  Games Showcase Section - Black and White
{% endcomment %}

<section class="games-showcase section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="games">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-heading font-bold mb-6 text-white">
        {{ section.settings.heading | default: "Games" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-white max-w-3xl mx-auto">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Games Grid -->
    {% if section.settings.collection != blank %}
      {% assign collection = collections[section.settings.collection] %}

      {% if collection.products.size > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {% for product in collection.products limit: 6 %}
            <div class="product-card border border-white/20 p-6" style="background-color: #111;">

              {% if product.featured_image %}
                <a href="{{ product.url }}">
                  <img src="{{ product.featured_image | image_url: width: 400 }}"
                       alt="{{ product.title }}"
                       class="w-full mb-4"
                       loading="lazy">
                </a>
              {% endif %}

              <h3 class="text-xl font-heading font-bold mb-2 text-white">
                <a href="{{ product.url }}" class="hover:opacity-70 transition-opacity">
                  {{ product.title }}
                </a>
              </h3>

              <p class="text-white text-2xl font-bold mb-4">
                {{ product.price | money }}
              </p>

              <a href="{{ product.url }}" class="btn btn-primary w-full">
                View Product
              </a>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="text-center py-12">
          <p class="text-white text-lg mb-4">
            No products in this collection yet.
          </p>
          <p class="text-white/60">
            Add products to the "{{ section.settings.collection }}" collection.
          </p>
        </div>
      {% endif %}
    {% else %}
      <div class="text-center py-12">
        <p class="text-white text-lg mb-4">
          This section will display your game products.
        </p>
        <p class="text-white/60">
          Select a collection in the theme customizer.
        </p>
      </div>
    {% endif %}

  </div>
</section>

<style>
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    cursor: pointer;
    border-radius: 0;
    text-decoration: none;
    text-align: center;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
  }

  .btn-primary:hover {
    background-color: #000000;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "Games Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Games"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Games Showcase"
    }
  ]
}
{% endschema %}
