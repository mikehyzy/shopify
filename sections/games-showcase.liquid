{% comment %}
  Games Showcase Section
  Features: Product cards with 3D effects, quick shop modal, AJAX cart
{% endcomment %}

<section class="games-showcase section bg-midnight relative overflow-hidden"
         id="games"
         data-section-type="games-showcase"
         data-section-id="{{ section.id }}">

  <!-- Background decoration -->
  <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-brass/5 rounded-full blur-3xl"></div>

  <div class="container-custom relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-hero font-heading font-bold mb-6 gradient-text"
          data-scroll-reveal>
        {{ section.settings.heading | default: "Future-Thinking Games" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-chicago-grey max-w-3xl mx-auto"
           data-scroll-reveal>
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Games Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">

      {% if section.settings.collection != blank %}
        {% assign collection = collections[section.settings.collection] %}

        {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="game-card group"
               data-scroll-reveal
               data-product-id="{{ product.id }}">

            <!-- Product Card -->
            <div class="card card-hover relative overflow-hidden">

              <!-- Product Image -->
              <div class="relative aspect-square overflow-hidden rounded-t-lg mb-6">
                {% if product.featured_image %}
                  <a href="{{ product.url }}" class="block">
                    {{ product.featured_image | image_url: width: 800 | image_tag:
                       class: 'w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700',
                       loading: 'lazy',
                       alt: product.title
                    }}
                  </a>

                  <!-- Hover overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-midnight via-midnight/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end justify-center pb-8">
                    <a href="{{ product.url }}"
                       class="btn btn-ghost text-sm">
                      View Details
                    </a>
                  </div>
                {% else %}
                  <div class="w-full h-full bg-deep-blue flex items-center justify-center">
                    <span class="text-chicago-grey">No image</span>
                  </div>
                {% endif %}

                <!-- Sale badge -->
                {% if product.compare_at_price > product.price %}
                  <div class="absolute top-4 right-4 bg-electric text-midnight px-3 py-1 rounded-full text-xs font-heading font-bold uppercase">
                    Sale
                  </div>
                {% endif %}

                <!-- New badge -->
                {% if product.tags contains 'new' %}
                  <div class="absolute top-4 left-4 bg-brass text-midnight px-3 py-1 rounded-full text-xs font-heading font-bold uppercase">
                    New
                  </div>
                {% endif %}
              </div>

              <!-- Product Info -->
              <div class="px-6 pb-6">

                <!-- Product Title -->
                <h3 class="text-2xl font-heading font-bold mb-3">
                  <a href="{{ product.url }}"
                     class="hover:text-brass transition-colors">
                    {{ product.title }}
                  </a>
                </h3>

                <!-- Product Description -->
                {% if product.description != blank %}
                  <p class="text-chicago-grey text-sm mb-4 line-clamp-3">
                    {{ product.description | strip_html | truncate: 150 }}
                  </p>
                {% endif %}

                <!-- Product metafields (if available) -->
                {% if product.metafields.custom.complexity %}
                  <div class="flex items-center mb-4">
                    <span class="text-xs text-chicago-grey mr-2">Complexity:</span>
                    <div class="flex space-x-1">
                      {% assign complexity = product.metafields.custom.complexity | default: 3 %}
                      {% for i in (1..5) %}
                        <svg class="w-4 h-4 {% if i <= complexity %}text-brass{% else %}text-chicago-grey/30{% endif %}"
                             fill="currentColor"
                             viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}

                <!-- Price -->
                <div class="flex items-baseline justify-between mb-6">
                  <div>
                    {% if product.compare_at_price > product.price %}
                      <span class="text-chicago-grey line-through text-sm mr-2">
                        {{ product.compare_at_price | money }}
                      </span>
                      <span class="text-electric text-2xl font-heading font-bold">
                        {{ product.price | money }}
                      </span>
                    {% else %}
                      <span class="text-brass text-2xl font-heading font-bold">
                        {{ product.price | money }}
                      </span>
                    {% endif %}
                  </div>

                  {% if product.available %}
                    <span class="text-xs text-electric">In Stock</span>
                  {% else %}
                    <span class="text-xs text-chicago-grey">Sold Out</span>
                  {% endif %}
                </div>

                <!-- Add to Cart Button -->
                {% if product.available %}
                  <button class="btn btn-primary w-full quick-shop-btn"
                          data-product-id="{{ product.id }}"
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                    Quick Shop
                  </button>
                {% else %}
                  <button class="btn btn-ghost w-full opacity-50 cursor-not-allowed"
                          disabled>
                    Sold Out
                  </button>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}

      {% else %}
        <!-- Placeholder if no collection selected -->
        <div class="col-span-2 text-center py-12">
          <p class="text-chicago-grey">
            Please select a collection in theme settings.
          </p>
        </div>
      {% endif %}
    </div>

    <!-- View All Link -->
    {% if section.settings.show_view_all and section.settings.collection != blank %}
      <div class="text-center mt-12"
           data-scroll-reveal>
        <a href="{{ collections[section.settings.collection].url }}"
           class="btn btn-secondary">
          View All Games
        </a>
      </div>
    {% endif %}
  </div>
</section>

<!-- Quick Shop Modal -->
<div id="quick-shop-modal"
     class="fixed inset-0 bg-midnight/95 backdrop-blur-md z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
     x-data="{ open: false, loading: false, addedToCart: false }"
     :class="open ? 'opacity-100 pointer-events-auto' : ''"
     @click.self="open = false">

  <div class="bg-deep-blue rounded-2xl max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto border border-brass/20"
       x-show="open"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 transform scale-95"
       x-transition:enter-end="opacity-100 transform scale-100"
       x-transition:leave="transition ease-in duration-200"
       x-transition:leave-start="opacity-100 transform scale-100"
       x-transition:leave-end="opacity-0 transform scale-95">

    <!-- Modal Header -->
    <div class="flex items-center justify-between p-6 border-b border-brass/20">
      <h3 class="text-2xl font-heading font-bold" id="modal-product-title">Product Details</h3>
      <button @click="open = false"
              class="text-chicago-grey hover:text-white transition-colors"
              aria-label="Close modal">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Modal Content -->
    <div id="modal-content" class="p-6">
      <!-- Content will be loaded dynamically -->
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);

    // Scroll reveal animations
    const revealElements = document.querySelectorAll('[data-scroll-reveal]');
    revealElements.forEach((el, index) => {
      gsap.from(el, {
        scrollTrigger: {
          trigger: el,
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        },
        y: 50,
        opacity: 0,
        duration: 0.8,
        delay: index * 0.1,
        ease: 'power3.out'
      });
    });

    // 3D tilt effect on game cards
    const gameCards = document.querySelectorAll('.game-card');
    gameCards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = (y - centerY) / 20;
        const rotateY = (centerX - x) / 20;

        gsap.to(card.querySelector('.card'), {
          rotateX: rotateX,
          rotateY: rotateY,
          duration: 0.5,
          ease: 'power2.out',
          transformPerspective: 1000
        });
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card.querySelector('.card'), {
          rotateX: 0,
          rotateY: 0,
          duration: 0.5,
          ease: 'power2.out'
        });
      });
    });

    // Quick shop functionality
    const quickShopButtons = document.querySelectorAll('.quick-shop-btn');
    quickShopButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const productId = btn.dataset.productId;
        const variantId = btn.dataset.variantId;

        // Show loading state
        btn.innerHTML = '<div class="spinner mx-auto"></div>';

        try {
          // Fetch product data
          const response = await fetch(`/products/${productId}.js`);
          const product = await response.json();

          // Open modal with product details
          openQuickShopModal(product, variantId);

        } catch (error) {
          console.error('Error fetching product:', error);
          alert('Sorry, there was an error loading the product.');
        } finally {
          // Restore button text
          btn.textContent = 'Quick Shop';
        }
      });
    });

    // Function to open quick shop modal
    function openQuickShopModal(product, variantId) {
      const modal = document.getElementById('quick-shop-modal');
      const modalContent = document.getElementById('modal-content');
      const modalTitle = document.getElementById('modal-product-title');

      modalTitle.textContent = product.title;

      // Build modal content
      const variant = product.variants.find(v => v.id == variantId) || product.variants[0];

      modalContent.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Product Image -->
          <div>
            <img src="${product.featured_image}"
                 alt="${product.title}"
                 class="w-full rounded-lg">
          </div>

          <!-- Product Details -->
          <div>
            <p class="text-chicago-grey mb-6">${product.description}</p>

            <div class="mb-6">
              <span class="text-4xl font-heading font-bold text-brass">
                $${(variant.price / 100).toFixed(2)}
              </span>
            </div>

            <form class="add-to-cart-form">
              <input type="hidden" name="id" value="${variant.id}">
              <button type="submit" class="btn btn-primary w-full">
                Add to Cart
              </button>
            </form>

            <a href="${product.url}"
               class="block text-center mt-4 text-electric hover:underline">
              View Full Details
            </a>
          </div>
        </div>
      `;

      // Handle add to cart
      const form = modalContent.querySelector('.add-to-cart-form');
      form.addEventListener('submit', handleAddToCart);

      // Open modal
      Alpine.store('quickShopModal', { open: true });
    }

    // Add to cart handler
    async function handleAddToCart(e) {
      e.preventDefault();

      const formData = new FormData(e.target);
      const submitBtn = e.target.querySelector('button[type="submit"]');

      submitBtn.innerHTML = '<div class="spinner mx-auto"></div>';

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        });

        if (response.ok) {
          const item = await response.json();

          // Update cart count
          const cartResponse = await fetch('/cart.js');
          const cart = await cartResponse.json();

          // Update cart icon
          const cartCountElements = document.querySelectorAll('[x-text="cartCount"]');
          cartCountElements.forEach(el => {
            el.textContent = cart.item_count;
          });

          // Show success message
          submitBtn.textContent = '✓ Added to Cart!';
          submitBtn.classList.add('bg-electric');

          setTimeout(() => {
            submitBtn.textContent = 'Add to Cart';
            submitBtn.classList.remove('bg-electric');
          }, 2000);

        } else {
          throw new Error('Failed to add to cart');
        }

      } catch (error) {
        console.error('Error adding to cart:', error);
        submitBtn.textContent = 'Error - Try Again';

        setTimeout(() => {
          submitBtn.textContent = 'Add to Cart';
        }, 2000);
      }
    }
  });
</script>

{% schema %}
{
  "name": "Games Showcase",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Future-Thinking Games"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our collection of card games designed to unlock futures thinking"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products to show",
      "min": 2,
      "max": 12,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Games Showcase"
    }
  ]
}
{% endschema %}
