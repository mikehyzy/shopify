{% comment %}
  Manifesto Section - Black and White
{% endcomment %}

<section class="manifesto-section section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="manifesto">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-heading font-bold mb-6 text-white">
        {{ section.settings.heading | default: "Our Manifesto" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-white max-w-3xl mx-auto">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Content -->
    <div class="max-w-4xl mx-auto">

      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="mb-8 p-8 border border-white/20" style="background-color: #111;">
            <h3 class="text-2xl font-heading font-bold mb-4 text-white">
              {{ block.settings.title }}
            </h3>
            {% if block.settings.content != blank %}
              <div class="text-white">
                {{ block.settings.content }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholder content -->
        <div class="text-center py-12">
          <p class="text-white text-lg mb-4">
            This section will display your manifesto content.
          </p>
          <p class="text-white/60">
            Add content blocks in the theme customizer.
          </p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Manifesto"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Content Panel",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Panel Title"
        },
        {
          "type": "html",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manifesto"
    }
  ]
}
{% endschema %}
