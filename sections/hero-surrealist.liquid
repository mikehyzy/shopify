{% comment %}
  Hero Section with Surrealist Design
  Features: GSAP animations, parallax effects, typewriter text, floating shapes
{% endcomment %}

<section class="hero-surrealist relative min-h-screen flex items-center justify-center overflow-hidden bg-surreal"
         id="hero"
         data-section-type="hero"
         data-section-id="{{ section.id }}">

  <!-- Background animated shapes -->
  <div class="absolute inset-0 pointer-events-none" id="hero-bg-shapes">
    <!-- SVG morphing shapes -->
    <svg class="absolute inset-0 w-full h-full opacity-10" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="gradient1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:{{ section.settings.shape_color_1 | default: '#d4af37' }};stop-opacity:0.3" />
          <stop offset="100%" style="stop-color:{{ section.settings.shape_color_2 | default: '#00d4ff' }};stop-opacity:0.3" />
        </linearGradient>
      </defs>

      <!-- Morphing blob 1 -->
      <path class="morphing-shape-1"
            fill="url(#gradient1)"
            d="M300,400 Q450,350 500,500 T600,700 Q550,800 400,750 T300,400 Z">
      </path>

      <!-- Morphing blob 2 -->
      <path class="morphing-shape-2"
            fill="url(#gradient1)"
            transform="translate(1200, 200)"
            d="M0,300 Q150,250 250,350 T350,550 Q300,650 150,600 T0,300 Z">
      </path>

      <!-- Geometric shapes -->
      <circle class="floating-shape" cx="200" cy="200" r="100" fill="{{ section.settings.accent_color | default: '#9b4dca' }}" opacity="0.1"/>
      <rect class="floating-shape" x="1500" y="700" width="150" height="150" fill="{{ section.settings.accent_color | default: '#00d4ff' }}" opacity="0.1" transform="rotate(45 1575 775)"/>
      <polygon class="floating-shape" points="1600,100 1700,150 1650,250 1550,250 1500,150" fill="{{ section.settings.accent_color | default: '#d4af37' }}" opacity="0.1"/>
    </svg>

    <!-- Particle container for React component -->
    <div id="particles-container" class="absolute inset-0"></div>
  </div>

  <!-- Grid overlay -->
  <div class="absolute inset-0 grid-overlay opacity-20"></div>

  <!-- Main content -->
  <div class="container-custom relative z-10">
    <div class="max-w-5xl mx-auto text-center">

      <!-- Eyebrow text -->
      {% if section.settings.eyebrow_text != blank %}
        <p class="eyebrow text-brass font-heading text-sm md:text-base uppercase tracking-widest mb-6 opacity-0"
           data-gsap="fadeIn">
          {{ section.settings.eyebrow_text }}
        </p>
      {% endif %}

      <!-- Main headline with typewriter effect -->
      <h1 class="hero-title text-display font-heading font-bold mb-8 leading-tight"
          data-gsap="typewriter"
          data-text="{{ section.settings.heading | default: 'Welcome to the Chicago Futures Salon' }}">
        <span class="gradient-text">{{ section.settings.heading | default: "Welcome to the Chicago Futures Salon" }}</span>
      </h1>

      <!-- Subtitle -->
      {% if section.settings.subheading != blank %}
        <p class="hero-subtitle text-xl md:text-2xl text-chicago-grey font-body mb-12 max-w-3xl mx-auto opacity-0"
           data-gsap="slideUp">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center opacity-0"
           data-gsap="slideUp">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}"
             class="btn btn-primary group">
            {{ section.settings.button_label }}
            <svg class="inline-block ml-2 w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.button_label_secondary != blank %}
          <a href="{{ section.settings.button_link_secondary }}"
             class="btn btn-secondary">
            {{ section.settings.button_label_secondary }}
          </a>
        {% endif %}
      </div>

      <!-- Manifesto quote -->
      {% if section.settings.show_quote %}
        <div class="mt-16 max-w-2xl mx-auto opacity-0" data-gsap="fadeIn">
          <blockquote class="border-l-4 border-brass pl-6">
            <p class="font-accent text-xl md:text-2xl text-electric italic">
              {{ section.settings.quote_text | default: "The marvelous is always beautiful, anything marvelous is beautiful, in fact only the marvelous is beautiful." }}
            </p>
            {% if section.settings.quote_author != blank %}
              <cite class="block mt-4 text-chicago-grey text-sm not-italic">
                — {{ section.settings.quote_author }}
              </cite>
            {% endif %}
          </blockquote>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-12 left-1/2 -translate-x-1/2 opacity-0"
       data-gsap="bounce"
       id="scroll-indicator">
    <a href="#content"
       class="flex flex-col items-center text-brass hover:text-electric transition-colors"
       aria-label="Scroll to content">
      <span class="text-xs uppercase tracking-wider mb-2 font-heading">Explore</span>
      <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </div>

  <!-- Parallax layers -->
  <div class="parallax-layers absolute inset-0 pointer-events-none">
    <div class="parallax-layer" data-depth="0.2">
      <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-brass/5 rounded-full blur-3xl"></div>
    </div>
    <div class="parallax-layer" data-depth="0.4">
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-electric/5 rounded-full blur-3xl"></div>
    </div>
  </div>
</section>

<script>
  // Initialize hero animations when GSAP is loaded
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') {
      console.warn('GSAP not loaded yet');
      return;
    }

    gsap.registerPlugin(ScrollTrigger, TextPlugin);

    // Typewriter effect for heading
    const heroTitle = document.querySelector('[data-gsap="typewriter"]');
    if (heroTitle) {
      const text = heroTitle.dataset.text;
      heroTitle.textContent = '';

      gsap.to(heroTitle, {
        duration: 2,
        text: text,
        ease: 'none',
        delay: 0.5
      });
    }

    // Fade in eyebrow
    gsap.to('[data-gsap="fadeIn"]', {
      opacity: 1,
      duration: 1,
      stagger: 0.2,
      delay: 0.3
    });

    // Slide up animations
    gsap.to('[data-gsap="slideUp"]', {
      opacity: 1,
      y: 0,
      duration: 1,
      stagger: 0.2,
      delay: 2.5,
      ease: 'power3.out'
    });

    // Scroll indicator bounce
    gsap.to('#scroll-indicator', {
      opacity: 1,
      delay: 3,
      duration: 0.8
    });

    // Morphing shapes animation
    const shapes = document.querySelectorAll('.morphing-shape-1, .morphing-shape-2');
    shapes.forEach((shape, index) => {
      gsap.to(shape, {
        morphSVG: {
          shape: shape,
          type: 'rotational'
        },
        duration: 8 + index * 2,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut'
      });
    });

    // Floating shapes
    const floatingShapes = document.querySelectorAll('.floating-shape');
    floatingShapes.forEach((shape, index) => {
      gsap.to(shape, {
        y: '+=30',
        x: '+=20',
        rotation: '+=15',
        duration: 4 + index,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
        delay: index * 0.5
      });
    });

    // Parallax effect on mouse move
    document.addEventListener('mousemove', (e) => {
      const { clientX, clientY } = e;
      const centerX = window.innerWidth / 2;
      const centerY = window.innerHeight / 2;

      const moveX = (clientX - centerX) / centerX;
      const moveY = (clientY - centerY) / centerY;

      document.querySelectorAll('.parallax-layer').forEach((layer) => {
        const depth = parseFloat(layer.dataset.depth) || 0.2;
        gsap.to(layer, {
          x: moveX * 50 * depth,
          y: moveY * 50 * depth,
          duration: 1,
          ease: 'power2.out'
        });
      });
    });

    // Hide scroll indicator on scroll
    ScrollTrigger.create({
      trigger: '#hero',
      start: 'top top',
      end: 'bottom top',
      onUpdate: (self) => {
        gsap.to('#scroll-indicator', {
          opacity: 1 - self.progress * 2,
          duration: 0.3
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Hero - Surrealist",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "An Invitation-Only Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to the Chicago Futures Salon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Exploring futures thinking through Surrealist, Situationist, and Futurist methods"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request Invitation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/invitation"
    },
    {
      "type": "text",
      "id": "button_label_secondary",
      "label": "Secondary button label",
      "default": "Explore Games"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link",
      "default": "/collections/games"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show quote",
      "default": true
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "The marvelous is always beautiful, anything marvelous is beautiful, in fact only the marvelous is beautiful."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author",
      "default": "André Breton"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color",
      "id": "shape_color_1",
      "label": "Shape color 1",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "shape_color_2",
      "label": "Shape color 2",
      "default": "#00d4ff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#9b4dca"
    }
  ],
  "presets": [
    {
      "name": "Hero - Surrealist"
    }
  ]
}
{% endschema %}
