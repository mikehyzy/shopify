{% comment %}
  Hero Section - Simple Black and White
{% endcomment %}

<section class="hero-surrealist relative min-h-screen flex items-center justify-center overflow-hidden"
         style="background-color: #000000;"
         id="hero"
         data-section-type="hero"
         data-section-id="{{ section.id }}">

  <!-- Main content -->
  <div class="container-custom relative z-10">
    <div class="max-w-7xl mx-auto text-center">

      <!-- Eyebrow text -->
      {% if section.settings.eyebrow_text != blank %}
        <p class="eyebrow text-white font-heading text-sm md:text-base uppercase tracking-widest mb-6"
           data-gsap="fadeIn">
          {{ section.settings.eyebrow_text }}
        </p>
      {% endif %}

      <!-- Main headline -->
      <h1 class="hero-title text-display font-heading font-bold mb-8 leading-tight text-white"
          data-gsap="typewriter"
          data-text="{{ section.settings.heading | default: 'Welcome to the Chicago Futures Salon' }}">
        {{ section.settings.heading | default: "Welcome to the Chicago Futures Salon" }}
      </h1>

      <!-- Subtitle -->
      {% if section.settings.subheading != blank %}
        <p class="hero-subtitle text-xl md:text-2xl text-white font-body mb-12 max-w-5xl mx-auto"
           style="white-space: pre-line;"
           data-gsap="slideUp">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center"
           data-gsap="slideUp">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}"
             class="btn btn-primary group">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.button_label_secondary != blank %}
          <a href="{{ section.settings.button_link_secondary }}"
             class="btn btn-secondary">
            {{ section.settings.button_label_secondary }}
          </a>
        {% endif %}
      </div>

      <!-- Quote -->
      {% if section.settings.show_quote and section.settings.quote_text != blank %}
        <div class="mt-16 max-w-2xl mx-auto" data-gsap="fadeIn">
          <blockquote class="border-l-4 border-white pl-6">
            <p class="font-body text-xl md:text-2xl text-white italic">
              "{{ section.settings.quote_text }}"
            </p>
            {% if section.settings.quote_author != blank %}
              <cite class="block mt-4 text-white text-sm not-italic">
                — {{ section.settings.quote_author }}
              </cite>
            {% endif %}
          </blockquote>
        </div>
      {% endif %}
    </div>
  </div>

</section>

<style>
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    cursor: pointer;
    border-radius: 0;
    text-decoration: none;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
  }

  .btn-primary:hover {
    background-color: #000000;
    color: #ffffff;
  }

  .btn-secondary {
    border: 2px solid #ffffff;
    color: #ffffff;
    background: transparent;
  }

  .btn-secondary:hover {
    background-color: #ffffff;
    color: #000000;
  }
</style>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "An Invitation-Only Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to the Chicago Futures Salon"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Exploring futures thinking"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request Invitation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label_secondary",
      "label": "Secondary button label",
      "default": "Explore Provocations"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show quote",
      "default": true
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
