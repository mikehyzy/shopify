{% comment %}
  Events Timeline Section
  Features: Timeline layout, filter by category, RSVP integration
{% endcomment %}

<section class="events-timeline section bg-deep-blue relative"
         id="events"
         data-section-type="events-timeline"
         data-section-id="{{ section.id }}">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-hero font-heading font-bold mb-6 gradient-text"
          data-scroll-reveal>
        {{ section.settings.heading | default: "Upcoming Events" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-chicago-grey max-w-3xl mx-auto"
           data-scroll-reveal>
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Event Filters -->
    {% if section.settings.show_filters %}
      <div class="flex flex-wrap justify-center gap-4 mb-12"
           data-scroll-reveal
           x-data="{ activeFilter: 'all' }">

        <button @click="activeFilter = 'all'"
                :class="activeFilter === 'all' ? 'btn-primary' : 'btn-ghost'"
                class="btn text-sm">
          All Events
        </button>

        {% for block in section.blocks %}
          {% if block.type == 'event' %}
            {% assign category = block.settings.category | default: 'salon' %}
            <button @click="activeFilter = '{{ category }}'"
                    :class="activeFilter === '{{ category }}' ? 'btn-primary' : 'btn-ghost'"
                    class="btn text-sm capitalize">
              {{ category }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <!-- Timeline -->
    <div class="relative max-w-4xl mx-auto">

      <!-- Timeline line -->
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-brass/20"
           id="timeline-line"></div>

      <!-- Events -->
      <div class="space-y-12"
           x-data="{ activeFilter: 'all' }">

        {% for block in section.blocks %}
          {% if block.type == 'event' %}
            {% assign category = block.settings.category | default: 'salon' %}

            <div class="event-item relative"
                 data-scroll-reveal
                 data-category="{{ category }}"
                 data-block-id="{{ block.id }}"
                 x-show="activeFilter === 'all' || activeFilter === '{{ category }}'"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 transform scale-95"
                 x-transition:enter-end="opacity-100 transform scale-100">

              <!-- Timeline dot -->
              <div class="absolute left-8 md:left-1/2 w-4 h-4 bg-brass rounded-full border-4 border-deep-blue transform -translate-x-1/2 z-10"
                   style="top: 2rem;">
                <div class="absolute inset-0 bg-brass rounded-full animate-ping opacity-75"></div>
              </div>

              <!-- Event card -->
              <div class="ml-20 md:ml-0 md:w-5/12 {% if forloop.index0 | modulo: 2 == 0 %}md:mr-auto md:pr-12{% else %}md:ml-auto md:pl-12{% endif %}">

                <div class="card card-hover p-6">

                  <!-- Event Date Badge -->
                  {% if block.settings.event_date != blank %}
                    <div class="inline-block bg-brass text-midnight px-4 py-2 rounded-full text-sm font-heading font-bold mb-4">
                      {{ block.settings.event_date | date: "%b %d, %Y" }}
                    </div>
                  {% endif %}

                  <!-- Event Title -->
                  <h3 class="text-2xl font-heading font-bold mb-3">
                    {{ block.settings.title }}
                  </h3>

                  <!-- Event Details -->
                  <div class="space-y-2 mb-4 text-sm text-chicago-grey">

                    <!-- Time -->
                    {% if block.settings.event_time != blank %}
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        {{ block.settings.event_time }}
                      </div>
                    {% endif %}

                    <!-- Location -->
                    {% if block.settings.location != blank %}
                      <div class="flex items-center">
                        <svg class="w-4 h-4 mr-2 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        {{ block.settings.location }}
                      </div>
                    {% endif %}

                    <!-- Category -->
                    <div class="flex items-center">
                      <svg class="w-4 h-4 mr-2 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                      </svg>
                      <span class="capitalize">{{ category }}</span>
                    </div>
                  </div>

                  <!-- Event Description -->
                  {% if block.settings.description != blank %}
                    <p class="text-chicago-grey text-sm leading-relaxed mb-6">
                      {{ block.settings.description }}
                    </p>
                  {% endif %}

                  <!-- Event Image -->
                  {% if block.settings.image != blank %}
                    <div class="mb-6 rounded-lg overflow-hidden">
                      {{ block.settings.image | image_url: width: 600 | image_tag:
                         class: 'w-full h-48 object-cover',
                         loading: 'lazy',
                         alt: block.settings.title
                      }}
                    </div>
                  {% endif %}

                  <!-- Facilitator -->
                  {% if block.settings.facilitator != blank %}
                    <div class="flex items-center mb-6 pb-6 border-b border-brass/20">
                      <div class="w-12 h-12 rounded-full bg-brass/20 flex items-center justify-center mr-3">
                        <svg class="w-6 h-6 text-brass" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                        </svg>
                      </div>
                      <div>
                        <p class="text-xs text-chicago-grey">Facilitated by</p>
                        <p class="font-heading font-semibold">{{ block.settings.facilitator }}</p>
                      </div>
                    </div>
                  {% endif %}

                  <!-- RSVP Button -->
                  {% if block.settings.show_rsvp %}
                    {% if customer %}
                      <button class="btn btn-primary w-full rsvp-btn"
                              data-event-id="{{ block.id }}"
                              data-event-title="{{ block.settings.title }}">
                        RSVP to Event
                      </button>
                    {% else %}
                      <a href="/account/login"
                         class="btn btn-secondary w-full">
                        Login to RSVP
                      </a>
                    {% endif %}
                  {% endif %}

                  <!-- Learn More Link -->
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}"
                       class="block text-center mt-4 text-electric hover:underline text-sm">
                      Learn More →
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- No Events Message -->
    {% if section.blocks.size == 0 %}
      <div class="text-center py-12">
        <p class="text-chicago-grey text-lg">
          No upcoming events at the moment. Check back soon!
        </p>
      </div>
    {% endif %}

    <!-- Past Events Link -->
    {% if section.settings.show_past_events_link %}
      <div class="text-center mt-16"
           data-scroll-reveal>
        <a href="{{ section.settings.past_events_url }}"
           class="btn btn-ghost">
          View Past Events
        </a>
      </div>
    {% endif %}
  </div>
</section>

<!-- RSVP Modal -->
<div id="rsvp-modal"
     class="fixed inset-0 bg-midnight/95 backdrop-blur-md z-50 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
     x-data="{ open: false, eventTitle: '', eventId: '' }"
     :class="open ? 'opacity-100 pointer-events-auto' : ''"
     @click.self="open = false">

  <div class="bg-deep-blue rounded-2xl max-w-md w-full mx-4 border border-brass/20 p-8"
       x-show="open"
       x-transition:enter="transition ease-out duration-300"
       x-transition:enter-start="opacity-0 transform scale-95"
       x-transition:enter-end="opacity-100 transform scale-100">

    <h3 class="text-2xl font-heading font-bold mb-4">
      RSVP Confirmation
    </h3>

    <p class="text-chicago-grey mb-6">
      You are registering for: <span class="text-white font-semibold" x-text="eventTitle"></span>
    </p>

    <form class="rsvp-form">
      <div class="mb-4">
        <label class="form-label">Dietary Restrictions</label>
        <input type="text"
               name="dietary_restrictions"
               class="form-input"
               placeholder="Optional">
      </div>

      <div class="mb-6">
        <label class="form-label">Special Requests</label>
        <textarea name="special_requests"
                  class="form-input"
                  rows="3"
                  placeholder="Optional"></textarea>
      </div>

      <div class="flex gap-4">
        <button type="button"
                @click="open = false"
                class="btn btn-ghost flex-1">
          Cancel
        </button>
        <button type="submit"
                class="btn btn-primary flex-1">
          Confirm RSVP
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);

    // Scroll reveal animations
    const revealElements = document.querySelectorAll('[data-scroll-reveal]');
    revealElements.forEach((el, index) => {
      gsap.from(el, {
        scrollTrigger: {
          trigger: el,
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        },
        y: 50,
        opacity: 0,
        duration: 0.8,
        delay: index * 0.1,
        ease: 'power3.out'
      });
    });

    // Animate timeline line
    gsap.from('#timeline-line', {
      scrollTrigger: {
        trigger: '#timeline-line',
        start: 'top 80%',
        end: 'bottom 20%',
        scrub: 1
      },
      scaleY: 0,
      transformOrigin: 'top',
      ease: 'none'
    });

    // RSVP functionality
    const rsvpButtons = document.querySelectorAll('.rsvp-btn');
    rsvpButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const eventId = btn.dataset.eventId;
        const eventTitle = btn.dataset.eventTitle;

        // Set Alpine data
        Alpine.store('rsvpModal', {
          open: true,
          eventTitle: eventTitle,
          eventId: eventId
        });
      });
    });

    // Handle RSVP form submission
    const rsvpForm = document.querySelector('.rsvp-form');
    if (rsvpForm) {
      rsvpForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(e.target);
        const submitBtn = e.target.querySelector('button[type="submit"]');

        submitBtn.innerHTML = '<div class="spinner mx-auto"></div>';

        try {
          // Here you would send the RSVP to your backend
          // For now, we'll simulate a successful RSVP
          await new Promise(resolve => setTimeout(resolve, 1000));

          // Show success message
          submitBtn.textContent = '✓ RSVP Confirmed!';
          submitBtn.classList.add('bg-electric');

          setTimeout(() => {
            Alpine.store('rsvpModal', { open: false });
            submitBtn.textContent = 'Confirm RSVP';
            submitBtn.classList.remove('bg-electric');
          }, 2000);

        } catch (error) {
          console.error('Error submitting RSVP:', error);
          submitBtn.textContent = 'Error - Try Again';

          setTimeout(() => {
            submitBtn.textContent = 'Confirm RSVP';
          }, 2000);
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Events Timeline",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Events"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filters",
      "default": true
    },
    {
      "type": "header",
      "content": "Past Events"
    },
    {
      "type": "checkbox",
      "id": "show_past_events_link",
      "label": "Show past events link",
      "default": true
    },
    {
      "type": "url",
      "id": "past_events_url",
      "label": "Past events URL"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Event title",
          "default": "Futures Salon Session"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "event_date",
          "label": "Event date",
          "info": "Format: YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "event_time",
          "label": "Event time",
          "default": "6:00 PM - 8:30 PM CST"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Chicago, IL"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "salon", "label": "Salon" },
            { "value": "workshop", "label": "Workshop" },
            { "value": "game-night", "label": "Game Night" },
            { "value": "special", "label": "Special Event" }
          ],
          "default": "salon"
        },
        {
          "type": "text",
          "id": "facilitator",
          "label": "Facilitator name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Event image"
        },
        {
          "type": "checkbox",
          "id": "show_rsvp",
          "label": "Show RSVP button",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Learn more link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events Timeline",
      "blocks": [
        { "type": "event" },
        { "type": "event" }
      ]
    }
  ]
}
{% endschema %}
