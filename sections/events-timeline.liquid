{% comment %}
  Events Timeline Section - Black and White
{% endcomment %}

<section class="events-timeline section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="events">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-heading font-bold mb-6 text-white">
        {{ section.settings.heading | default: "Events" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-white max-w-3xl mx-auto">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Events List -->
    <div class="max-w-4xl mx-auto">

      {% if section.blocks.size > 0 %}
        <div class="space-y-8">
          {% for block in section.blocks %}
            {% if block.type == 'event' %}
              <div class="event-card border border-white/20 p-8" style="background-color: #111;">

                <div class="flex flex-col md:flex-row gap-6">

                  <div class="md:w-32 flex-shrink-0">
                    {% if block.settings.event_date != blank %}
                      <div class="text-center border border-white p-4">
                        <div class="text-3xl font-bold text-white">
                          {{ block.settings.event_date | date: "%d" }}
                        </div>
                        <div class="text-sm text-white uppercase">
                          {{ block.settings.event_date | date: "%b %Y" }}
                        </div>
                      </div>
                    {% endif %}
                  </div>

                  <div class="flex-1">
                    <h3 class="text-2xl font-heading font-bold mb-2 text-white">
                      {{ block.settings.title }}
                    </h3>

                    {% if block.settings.event_time != blank %}
                      <p class="text-white/70 mb-2">
                        🕐 {{ block.settings.event_time }}
                      </p>
                    {% endif %}

                    {% if block.settings.location != blank %}
                      <p class="text-white/70 mb-4">
                        📍 {{ block.settings.location }}
                      </p>
                    {% endif %}

                    {% if block.settings.description != blank %}
                      <p class="text-white mb-4">
                        {{ block.settings.description }}
                      </p>
                    {% endif %}

                    {% if block.settings.show_rsvp %}
                      <a href="{{ block.settings.rsvp_link }}" class="btn btn-primary">
                        RSVP
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="text-center py-12">
          <p class="text-white text-lg mb-4">
            This section will display your upcoming events.
          </p>
          <p class="text-white/60">
            Add event blocks in the theme customizer.
          </p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    cursor: pointer;
    border-radius: 0;
    text-decoration: none;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
  }

  .btn-primary:hover {
    background-color: #000000;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "Events Timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Events"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Event title",
          "default": "Event Name"
        },
        {
          "type": "text",
          "id": "event_date",
          "label": "Event date",
          "info": "Format: YYYY-MM-DD"
        },
        {
          "type": "text",
          "id": "event_time",
          "label": "Event time",
          "default": "6:00 PM - 8:00 PM"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "checkbox",
          "id": "show_rsvp",
          "label": "Show RSVP button",
          "default": true
        },
        {
          "type": "url",
          "id": "rsvp_link",
          "label": "RSVP link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events Timeline"
    }
  ]
}
{% endschema %}
