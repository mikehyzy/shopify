{% comment %}
  Invitation Form Section - Black and White
{% endcomment %}

<section class="invitation-form-section section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="invitation">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-heading font-bold mb-6 text-white">
        {{ section.settings.heading | default: "Request an Invitation" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-white max-w-3xl mx-auto mb-8">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Form Container -->
    <div class="max-w-2xl mx-auto">
      <div class="border border-white/20 p-8" style="background-color: #111;">

        <form id="invitation-form" class="space-y-6" method="POST" action="https://formsubmit.co/{{ section.settings.notification_email }}" target="_blank">
          <input type="hidden" name="_subject" value="New Invitation Request - Chicago Futures Salon">
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_template" value="table">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-white text-sm font-bold mb-2" for="firstName">
                First Name *
              </label>
              <input type="text"
                     id="firstName"
                     name="firstName"
                     required
                     class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                     placeholder="John">
            </div>

            <div>
              <label class="block text-white text-sm font-bold mb-2" for="lastName">
                Last Name *
              </label>
              <input type="text"
                     id="lastName"
                     name="lastName"
                     required
                     class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                     placeholder="Doe">
            </div>
          </div>

          <div>
            <label class="block text-white text-sm font-bold mb-2" for="email">
              Email Address *
            </label>
            <input type="email"
                   id="email"
                   name="email"
                   required
                   class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                   placeholder="john@example.com">
          </div>

          <div>
            <label class="block text-white text-sm font-bold mb-2" for="organization">
              Organization *
            </label>
            <input type="text"
                   id="organization"
                   name="organization"
                   required
                   class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                   placeholder="Your company">
          </div>

          <div>
            <label class="block text-white text-sm font-bold mb-2" for="interest">
              Why are you interested? *
            </label>
            <textarea id="interest"
                      name="interest"
                      required
                      rows="4"
                      class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                      placeholder="Tell us about your interest in futures thinking..."></textarea>
          </div>

          <button type="submit"
                  id="submit-btn"
                  class="btn btn-primary w-full">
            Submit Request
          </button>

          <div id="success-message" style="display: none; color: #00d4ff; text-align: center; padding: 1rem; border: 1px solid #00d4ff; margin-top: 1rem;">
            Thank you! Your request has been submitted. We'll be in touch soon.
          </div>
        </form>

        <p class="text-white/60 text-sm text-center mt-6">
          * Required fields
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    cursor: pointer;
    border-radius: 0;
    text-decoration: none;
    text-align: center;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
  }

  .btn-primary:hover {
    background-color: #000000;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "Invitation Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request an Invitation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "notification_email",
      "label": "Email Address",
      "info": "Enter your email address to receive form submissions. First submission will require email confirmation.",
      "default": "contact@chicagofuturessalon.com"
    }
  ],
  "presets": [
    {
      "name": "Invitation Form"
    }
  ]
}
{% endschema %}

<script>
  document.getElementById('invitation-form').addEventListener('submit', function(e) {
    const email = '{{ section.settings.notification_email }}';

    if (!email || email === '') {
      e.preventDefault();
      alert('Email address not configured. Please contact the site administrator.');
      return;
    }

    // Change button text immediately
    document.getElementById('submit-btn').textContent = 'Submitting...';
    document.getElementById('submit-btn').disabled = true;

    // Note: FormSubmit will handle the actual submission in new tab
    // Show success message after brief delay
    setTimeout(function() {
      document.getElementById('success-message').style.display = 'block';
      document.getElementById('invitation-form').reset();
      document.getElementById('submit-btn').textContent = 'Request Submitted!';

      setTimeout(function() {
        document.getElementById('submit-btn').textContent = 'Submit Request';
        document.getElementById('submit-btn').disabled = false;
        document.getElementById('success-message').style.display = 'none';
      }, 5000);
    }, 500);
  });
</script>
