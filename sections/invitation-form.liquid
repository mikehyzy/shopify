{% comment %}
  Invitation Form Section - Black and White
{% endcomment %}

<section class="invitation-form-section section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="invitation">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-heading font-bold mb-6 text-white">
        {{ section.settings.heading | default: "Request an Invitation" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-white max-w-3xl mx-auto mb-8">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Form Container -->
    <div class="max-w-2xl mx-auto">
      <div class="border border-white/20 p-8" style="background-color: #111;">

        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div style="color: #00d4ff; text-align: center; padding: 1rem; border: 1px solid #00d4ff; margin-bottom: 1.5rem;">
              Thank you! Your request has been submitted. We'll be in touch soon.
            </div>
          {% endif %}

          {% if form.errors %}
            <div style="color: #ff6b6b; text-align: center; padding: 1rem; border: 1px solid #ff6b6b; margin-bottom: 1.5rem;">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <input type="hidden" name="contact[subject]" value="Invitation Request - Chicago Futures Salon">

          <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-white text-sm font-bold mb-2" for="firstName">
                  First Name *
                </label>
                <input type="text"
                       id="firstName"
                       name="contact[first_name]"
                       required
                       class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                       placeholder="John">
              </div>

              <div>
                <label class="block text-white text-sm font-bold mb-2" for="lastName">
                  Last Name *
                </label>
                <input type="text"
                       id="lastName"
                       name="contact[last_name]"
                       required
                       class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                       placeholder="Doe">
              </div>
            </div>

            <div>
              <label class="block text-white text-sm font-bold mb-2" for="email">
                Email Address *
              </label>
              <input type="email"
                     id="email"
                     name="contact[email]"
                     required
                     class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                     placeholder="john@example.com">
            </div>

            <div>
              <label class="block text-white text-sm font-bold mb-2" for="organization">
                Organization *
              </label>
              <input type="text"
                     id="organization"
                     name="contact[organization]"
                     required
                     class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                     placeholder="Your company">
            </div>

            <div>
              <label class="block text-white text-sm font-bold mb-2" for="interest">
                Why are you interested? *
              </label>
              <textarea id="interest"
                        name="contact[body]"
                        required
                        rows="4"
                        class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                        placeholder="Tell us about your interest in futures thinking..."></textarea>
            </div>

            <button type="submit"
                    class="btn btn-primary w-full">
              Submit Request
            </button>
          </div>
        {% endform %}

        <p class="text-white/60 text-sm text-center mt-6">
          * Required fields
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    cursor: pointer;
    border-radius: 0;
    text-decoration: none;
    text-align: center;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
  }

  .btn-primary:hover {
    background-color: #000000;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "Invitation Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request an Invitation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "paragraph",
      "content": "Form submissions will be sent to the email address configured in your Shopify store settings (Settings > General > Store contact email)."
    }
  ],
  "presets": [
    {
      "name": "Invitation Form"
    }
  ]
}
{% endschema %}
