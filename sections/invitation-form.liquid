{% comment %}
  Invitation Form Section
  Features: Multi-step form, validation, Shopify customer integration
{% endcomment %}

<section class="invitation-form-section section bg-surreal relative overflow-hidden"
         id="invitation"
         data-section-type="invitation-form"
         data-section-id="{{ section.id }}">

  <!-- Background decorations -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-brass/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-electric/5 rounded-full blur-3xl"></div>

  <div class="container-custom relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-hero font-heading font-bold mb-6 gradient-text"
          data-scroll-reveal>
        {{ section.settings.heading | default: "Request an Invitation" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-chicago-grey max-w-3xl mx-auto mb-8"
           data-scroll-reveal>
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      <!-- Quote -->
      {% if section.settings.show_quote and section.settings.quote_text != blank %}
        <blockquote class="max-w-2xl mx-auto mb-12 border-l-4 border-brass pl-6"
                    data-scroll-reveal>
          <p class="font-accent text-xl text-electric italic">
            {{ section.settings.quote_text }}
          </p>
          {% if section.settings.quote_author != blank %}
            <cite class="block mt-3 text-chicago-grey text-sm not-italic">
              — {{ section.settings.quote_author }}
            </cite>
          {% endif %}
        </blockquote>
      {% endif %}
    </div>

    <!-- Form Container -->
    <div class="max-w-3xl mx-auto">
      <div class="card p-8 md:p-12"
           data-scroll-reveal
           x-data="{
             currentStep: 1,
             totalSteps: 3,
             formData: {
               firstName: '',
               lastName: '',
               email: '',
               phone: '',
               organization: '',
               role: '',
               linkedin: '',
               interest: '',
               experience: '',
               futuresThinking: '',
               discovery: '',
               contribution: ''
             },
             submitted: false,
             errors: {}
           }">

        <!-- Progress Bar -->
        <div class="mb-8">
          <div class="flex justify-between items-center mb-4">
            <span class="text-sm font-heading uppercase tracking-wider text-chicago-grey">
              Step <span x-text="currentStep"></span> of <span x-text="totalSteps"></span>
            </span>
            <span class="text-sm text-brass">
              <span x-text="Math.round((currentStep / totalSteps) * 100)"></span>% Complete
            </span>
          </div>

          <div class="w-full bg-chicago-grey/30 rounded-full h-2 overflow-hidden">
            <div class="bg-gradient-to-r from-brass to-electric h-full rounded-full transition-all duration-500"
                 :style="`width: ${(currentStep / totalSteps) * 100}%`">
            </div>
          </div>
        </div>

        <!-- Form -->
        <form @submit.prevent="submitForm"
              class="space-y-8">

          <!-- Step 1: Personal Information -->
          <div x-show="currentStep === 1"
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="opacity-0 transform translate-x-8"
               x-transition:enter-end="opacity-100 transform translate-x-0">

            <h3 class="text-2xl font-heading font-bold mb-6 text-brass">
              Personal Information
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="form-label" for="firstName">
                  First Name <span class="text-electric">*</span>
                </label>
                <input type="text"
                       id="firstName"
                       x-model="formData.firstName"
                       required
                       class="form-input"
                       placeholder="John">
              </div>

              <div>
                <label class="form-label" for="lastName">
                  Last Name <span class="text-electric">*</span>
                </label>
                <input type="text"
                       id="lastName"
                       x-model="formData.lastName"
                       required
                       class="form-input"
                       placeholder="Doe">
              </div>
            </div>

            <div>
              <label class="form-label" for="email">
                Email Address <span class="text-electric">*</span>
              </label>
              <input type="email"
                     id="email"
                     x-model="formData.email"
                     required
                     class="form-input"
                     placeholder="john@example.com">
            </div>

            <div>
              <label class="form-label" for="phone">
                Phone Number
              </label>
              <input type="tel"
                     id="phone"
                     x-model="formData.phone"
                     class="form-input"
                     placeholder="+1 (555) 123-4567">
            </div>
          </div>

          <!-- Step 2: Professional Background -->
          <div x-show="currentStep === 2"
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="opacity-0 transform translate-x-8"
               x-transition:enter-end="opacity-100 transform translate-x-0">

            <h3 class="text-2xl font-heading font-bold mb-6 text-brass">
              Professional Background
            </h3>

            <div>
              <label class="form-label" for="organization">
                Organization <span class="text-electric">*</span>
              </label>
              <input type="text"
                     id="organization"
                     x-model="formData.organization"
                     required
                     class="form-input"
                     placeholder="Your company or organization">
            </div>

            <div>
              <label class="form-label" for="role">
                Your Role <span class="text-electric">*</span>
              </label>
              <input type="text"
                     id="role"
                     x-model="formData.role"
                     required
                     class="form-input"
                     placeholder="e.g., CEO, Director of Strategy">
            </div>

            <div>
              <label class="form-label" for="linkedin">
                LinkedIn Profile URL
              </label>
              <input type="url"
                     id="linkedin"
                     x-model="formData.linkedin"
                     class="form-input"
                     placeholder="https://linkedin.com/in/yourprofile">
            </div>

            <div>
              <label class="form-label" for="experience">
                Years of Leadership Experience <span class="text-electric">*</span>
              </label>
              <select id="experience"
                      x-model="formData.experience"
                      required
                      class="form-input">
                <option value="">Select range</option>
                <option value="3-5">3-5 years</option>
                <option value="5-10">5-10 years</option>
                <option value="10-15">10-15 years</option>
                <option value="15+">15+ years</option>
              </select>
            </div>
          </div>

          <!-- Step 3: Interest & Contribution -->
          <div x-show="currentStep === 3"
               x-transition:enter="transition ease-out duration-300"
               x-transition:enter-start="opacity-0 transform translate-x-8"
               x-transition:enter-end="opacity-100 transform translate-x-0">

            <h3 class="text-2xl font-heading font-bold mb-6 text-brass">
              Your Interest
            </h3>

            <div>
              <label class="form-label" for="interest">
                Why are you interested in the Chicago Futures Salon? <span class="text-electric">*</span>
              </label>
              <textarea id="interest"
                        x-model="formData.interest"
                        required
                        rows="4"
                        class="form-input"
                        placeholder="Share what draws you to futures thinking and this community..."></textarea>
            </div>

            <div>
              <label class="form-label" for="futuresThinking">
                Experience with Futures Thinking <span class="text-electric">*</span>
              </label>
              <select id="futuresThinking"
                      x-model="formData.futuresThinking"
                      required
                      class="form-input">
                <option value="">Select your experience level</option>
                <option value="none">No prior experience</option>
                <option value="beginner">Beginner - some exposure</option>
                <option value="intermediate">Intermediate - regular practice</option>
                <option value="advanced">Advanced - extensive experience</option>
              </select>
            </div>

            <div>
              <label class="form-label" for="discovery">
                How did you hear about us? <span class="text-electric">*</span>
              </label>
              <select id="discovery"
                      x-model="formData.discovery"
                      required
                      class="form-input">
                <option value="">Select an option</option>
                <option value="referral">Referral from a member</option>
                <option value="social">Social media</option>
                <option value="event">Event or conference</option>
                <option value="search">Online search</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label class="form-label" for="contribution">
                What would you like to contribute to the salon?
              </label>
              <textarea id="contribution"
                        x-model="formData.contribution"
                        rows="4"
                        class="form-input"
                        placeholder="Optional: Share your unique perspective, expertise, or what you'd bring to the community..."></textarea>
            </div>
          </div>

          <!-- Navigation Buttons -->
          <div class="flex justify-between items-center pt-6 border-t border-brass/20">

            <!-- Back Button -->
            <button type="button"
                    @click="currentStep > 1 && currentStep--"
                    x-show="currentStep > 1"
                    class="btn btn-ghost">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              Back
            </button>

            <div x-show="currentStep === 1"></div>

            <!-- Next/Submit Button -->
            <button type="button"
                    @click="currentStep < totalSteps && currentStep++"
                    x-show="currentStep < totalSteps"
                    class="btn btn-primary">
              Next
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>

            <button type="submit"
                    x-show="currentStep === totalSteps"
                    class="btn btn-primary">
              Submit Application
            </button>
          </div>
        </form>

        <!-- Success Message -->
        <div x-show="submitted"
             x-transition
             class="text-center py-12">

          <div class="w-20 h-20 bg-electric/20 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>

          <h3 class="text-3xl font-heading font-bold mb-4 text-brass">
            Application Received!
          </h3>

          <p class="text-chicago-grey mb-8">
            Thank you for your interest in the Chicago Futures Salon. We'll review your application and be in touch within 5-7 business days.
          </p>

          <p class="text-sm text-electric italic font-accent">
            "The marvelous awaits"
          </p>
        </div>
      </div>
    </div>

    <!-- Additional Info -->
    {% if section.settings.show_info_cards %}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16 max-w-5xl mx-auto">

        <div class="card text-center p-6" data-scroll-reveal>
          <div class="w-16 h-16 bg-brass/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-brass" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <h4 class="font-heading font-bold mb-2">Curated Community</h4>
          <p class="text-sm text-chicago-grey">
            Join senior leaders from diverse industries
          </p>
        </div>

        <div class="card text-center p-6" data-scroll-reveal>
          <div class="w-16 h-16 bg-electric/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h4 class="font-heading font-bold mb-2">Avant-Garde Methods</h4>
          <p class="text-sm text-chicago-grey">
            Explore Surrealist, Situationist techniques
          </p>
        </div>

        <div class="card text-center p-6" data-scroll-reveal>
          <div class="w-16 h-16 bg-dream-purple/20 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-dream-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h4 class="font-heading font-bold mb-2">Quarterly Sessions</h4>
          <p class="text-sm text-chicago-grey">
            Intimate gatherings in Chicago
          </p>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);

    // Scroll reveal animations
    const revealElements = document.querySelectorAll('[data-scroll-reveal]');
    revealElements.forEach((el, index) => {
      gsap.from(el, {
        scrollTrigger: {
          trigger: el,
          start: 'top 80%',
          toggleActions: 'play none none reverse'
        },
        y: 50,
        opacity: 0,
        duration: 0.8,
        delay: index * 0.1,
        ease: 'power3.out'
      });
    });
  });

  // Form submission handler
  function submitForm() {
    const formData = Alpine.raw(this.formData);

    // Validate required fields
    if (!formData.firstName || !formData.lastName || !formData.email ||
        !formData.organization || !formData.role || !formData.interest ||
        !formData.futuresThinking || !formData.discovery || !formData.experience) {
      alert('Please fill in all required fields');
      return;
    }

    // Show loading state
    const submitBtn = document.querySelector('button[type="submit"]');
    submitBtn.innerHTML = '<div class="spinner mx-auto"></div>';

    // Simulate form submission
    setTimeout(() => {
      this.submitted = true;

      // Here you would send the data to your backend
      console.log('Form data:', formData);

      // Confetti animation
      if (typeof confetti !== 'undefined') {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 }
        });
      }
    }, 1500);
  }
</script>

{% schema %}
{
  "name": "Invitation Form",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request an Invitation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "The Chicago Futures Salon is an invitation-only community. Share your interest and we'll be in touch."
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "checkbox",
      "id": "show_quote",
      "label": "Show quote",
      "default": true
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "We seek leaders who are willing to challenge assumptions and imagine radically different futures."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote author"
    },
    {
      "type": "header",
      "content": "Additional Options"
    },
    {
      "type": "checkbox",
      "id": "show_info_cards",
      "label": "Show info cards below form",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Invitation Form"
    }
  ]
}
{% endschema %}
