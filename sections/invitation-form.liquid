{% comment %}
  Invitation Form Section - Black and White
{% endcomment %}

<section class="invitation-form-section section relative"
         style="background-color: #000000; padding: 80px 0;"
         id="invitation">

  <div class="container-custom">

    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-heading font-bold mb-6 text-white">
        {{ section.settings.heading | default: "Request an Invitation" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="text-xl text-white max-w-3xl mx-auto mb-8">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Form Container -->
    <div class="max-w-2xl mx-auto">
      <div class="border border-white/20 p-8" style="background-color: #111;">

        <form class="space-y-6">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-white text-sm font-bold mb-2" for="firstName">
                First Name *
              </label>
              <input type="text"
                     id="firstName"
                     required
                     class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                     placeholder="John">
            </div>

            <div>
              <label class="block text-white text-sm font-bold mb-2" for="lastName">
                Last Name *
              </label>
              <input type="text"
                     id="lastName"
                     required
                     class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                     placeholder="Doe">
            </div>
          </div>

          <div>
            <label class="block text-white text-sm font-bold mb-2" for="email">
              Email Address *
            </label>
            <input type="email"
                   id="email"
                   required
                   class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                   placeholder="john@example.com">
          </div>

          <div>
            <label class="block text-white text-sm font-bold mb-2" for="organization">
              Organization *
            </label>
            <input type="text"
                   id="organization"
                   required
                   class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                   placeholder="Your company">
          </div>

          <div>
            <label class="block text-white text-sm font-bold mb-2" for="interest">
              Why are you interested? *
            </label>
            <textarea id="interest"
                      required
                      rows="4"
                      class="w-full px-4 py-3 bg-black border border-white/30 text-white focus:border-white focus:outline-none"
                      placeholder="Tell us about your interest in futures thinking..."></textarea>
          </div>

          <button type="submit"
                  class="btn btn-primary w-full">
            Submit Request
          </button>
        </form>

        <p class="text-white/60 text-sm text-center mt-6">
          * Required fields
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    cursor: pointer;
    border-radius: 0;
    text-decoration: none;
    text-align: center;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #ffffff;
  }

  .btn-primary:hover {
    background-color: #000000;
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "Invitation Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request an Invitation"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "presets": [
    {
      "name": "Invitation Form"
    }
  ]
}
{% endschema %}
