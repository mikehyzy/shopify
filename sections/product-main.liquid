{% comment %}
  Product Main Section
{% endcomment %}

<div class="product-page section" style="background-color: #000000; padding: 40px 0;">
  <div class="container-custom" style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">

    <!-- Breadcrumbs -->
    <nav class="mb-8" aria-label="Breadcrumb" style="margin-bottom: 2rem;">
      <ol style="display: flex; align-items: center; font-size: 0.875rem; color: #6c757d;">
        <li><a href="/" style="color: #6c757d; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#6c757d'">Home</a></li>
        <li style="margin: 0 0.5rem;">/</li>
        <li><a href="/collections/all" style="color: #6c757d; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#6c757d'">Provocations</a></li>
        <li style="margin: 0 0.5rem;">/</li>
        <li style="color: #ffffff;">{{ product.title }}</li>
      </ol>
    </nav>

    <!-- Product Content -->
    <div style="display: grid; grid-template-columns: 1fr; gap: 3rem; margin-bottom: 4rem;">

      <!-- Product Images -->
      <div class="product-images">

        <!-- Main Image -->
        <div style="margin-bottom: 1rem; border-radius: 0.5rem; overflow: hidden; background-color: #0a0a0a;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 800 }}"
                 alt="{{ product.title | escape }}"
                 id="main-product-image"
                 style="width: 100%; height: auto;">
          {% else %}
            <div style="width: 100%; aspect-ratio: 1; display: flex; align-items: center; justify-content: center;">
              <span style="color: #6c757d;">No image available</span>
            </div>
          {% endif %}
        </div>

        <!-- Thumbnail Gallery -->
        {% if product.images.size > 1 %}
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
            {% for image in product.images %}
              <button class="thumbnail-btn"
                      style="border-radius: 0.5rem; overflow: hidden; border: 2px solid {% if forloop.first %}#ffffff{% else %}transparent{% endif %}; transition: border-color 0.2s; background: none; padding: 0; cursor: pointer;"
                      onclick="changeMainImage('{{ image | image_url: width: 800 }}', this)">
                <img src="{{ image | image_url: width: 200 }}"
                     alt="{{ product.title | escape }} - Image {{ forloop.index }}"
                     style="width: 100%; height: auto; display: block;">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="product-info">

        <!-- Product Title -->
        <h1 style="font-size: clamp(2rem, 5vw, 3rem); font-family: 'Open Sans', sans-serif; font-weight: 700; color: #ffffff; margin-bottom: 1rem;">
          {{ product.title }}
        </h1>

        <!-- Product Price -->
        <div style="margin-bottom: 2rem;">
          {% if product.compare_at_price > product.price %}
            <span style="color: #6c757d; text-decoration: line-through; font-size: 1.25rem; margin-right: 0.75rem;">
              {{ product.compare_at_price | money }}
            </span>
            <span style="color: #00d4ff; font-size: 2.25rem; font-family: 'Open Sans', sans-serif; font-weight: 700;">
              {{ product.price | money }}
            </span>
            <span style="margin-left: 0.75rem; background-color: #00d4ff; color: #000000; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.875rem; font-weight: 700; text-transform: uppercase;">
              Save {{ product.compare_at_price | minus: product.price | money }}
            </span>
          {% else %}
            <span style="color: #ffffff; font-size: 2.25rem; font-family: 'Open Sans', sans-serif; font-weight: 700;">
              {{ product.price | money }}
            </span>
          {% endif %}
        </div>

        <!-- Product Description -->
        <div style="color: #ffffff; margin-bottom: 2rem; line-height: 1.75;">
          {{ product.description }}
        </div>

        <!-- Product Form -->
        {% form 'product', product, id: 'product-form' %}

          <!-- Hidden variant ID for single variant products -->
          {% if product.has_only_default_variant %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {% else %}
            <!-- Variant Selector (if multiple variants) -->
            <div style="margin-bottom: 1.5rem;">
              <label style="display: block; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; color: #6c757d;" for="product-select">
                Select Option
              </label>
              <select name="id"
                      id="product-select"
                      style="width: 100%; padding: 0.75rem 1rem; background-color: #0a0a0a; border: 1px solid rgba(255, 255, 255, 0.3); color: #ffffff; border-radius: 0.5rem; font-family: 'Open Sans', sans-serif; transition: all 0.2s;">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}"
                          {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} - {{ variant.price | money }}
                    {% unless variant.available %} (Sold Out){% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          <!-- Quantity -->
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; color: #6c757d;" for="quantity">
              Quantity
            </label>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <button type="button"
                      style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background-color: #0a0a0a; border: 1px solid rgba(108, 117, 125, 0.5); color: #ffffff; transition: border-color 0.2s; cursor: pointer;"
                      onclick="decrementQuantity()">
                <svg style="width: 1.25rem; height: 1.25rem; margin: 0 auto;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                </svg>
              </button>

              <input type="number"
                     id="quantity"
                     name="quantity"
                     value="1"
                     min="1"
                     style="width: 5rem; padding: 0.75rem 1rem; background-color: #0a0a0a; border: 1px solid rgba(255, 255, 255, 0.3); color: #ffffff; border-radius: 0.5rem; text-align: center; font-family: 'Open Sans', sans-serif;">

              <button type="button"
                      style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background-color: #0a0a0a; border: 1px solid rgba(108, 117, 125, 0.5); color: #ffffff; transition: border-color 0.2s; cursor: pointer;"
                      onclick="incrementQuantity()">
                <svg style="width: 1.25rem; height: 1.25rem; margin: 0 auto;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Add to Cart Button -->
          <button type="submit"
                  name="add"
                  id="add-to-cart-btn"
                  style="width: 100%; padding: 1rem 2rem; background-color: #ffffff; color: #000000; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.025em; border: 2px solid #ffffff; transition: all 0.3s; cursor: pointer; margin-bottom: 1rem; border-radius: 0;"
                  {% unless product.available %}disabled{% endunless %}>

            {% if product.available %}
              <svg style="width: 1.25rem; height: 1.25rem; margin-right: 0.5rem; display: inline-block; vertical-align: middle;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>

          <!-- Buy Now Button (optional) -->
          {% if product.available %}
            <button type="button"
                    style="width: 100%; padding: 1rem 2rem; background-color: transparent; color: #ffffff; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.025em; border: 2px solid #ffffff; transition: all 0.3s; cursor: pointer; border-radius: 0;"
                    onclick="buyNow()">
              Buy Now
            </button>
          {% endif %}

        {% endform %}

        <!-- Additional Info -->
        <div style="margin-top: 2rem;">

          <!-- Shipping Info -->
          <div style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.875rem; margin-bottom: 1rem;">
            <svg style="width: 1.25rem; height: 1.25rem; color: #00d4ff; margin-top: 0.125rem; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
            </svg>
            <div>
              <p style="font-weight: 600; color: #ffffff; margin-bottom: 0.25rem;">Free Shipping</p>
              <p style="color: #6c757d;">On orders over $50</p>
            </div>
          </div>

          <!-- Returns -->
          <div style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.875rem; margin-bottom: 1rem;">
            <svg style="width: 1.25rem; height: 1.25rem; color: #00d4ff; margin-top: 0.125rem; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
            </svg>
            <div>
              <p style="font-weight: 600; color: #ffffff; margin-bottom: 0.25rem;">Easy Returns</p>
              <p style="color: #6c757d;">30-day return policy</p>
            </div>
          </div>

          <!-- Support -->
          <div style="display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.875rem;">
            <svg style="width: 1.25rem; height: 1.25rem; color: #00d4ff; margin-top: 0.125rem; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <div>
              <p style="font-weight: 600; color: #ffffff; margin-bottom: 0.25rem;">Customer Support</p>
              <p style="color: #6c757d;">We're here to help</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  .thumbnail-btn:hover {
    border-color: rgba(255, 255, 255, 0.5) !important;
  }

  #add-to-cart-btn:hover {
    background-color: #000000;
    color: #ffffff;
  }

  @media (min-width: 1024px) {
    .product-page .container-custom > div {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

<script>
  // Change main product image
  function changeMainImage(imageSrc, button) {
    document.getElementById('main-product-image').src = imageSrc;

    // Update active state
    document.querySelectorAll('.thumbnail-btn').forEach(btn => {
      btn.style.borderColor = 'transparent';
    });
    button.style.borderColor = '#ffffff';
  }

  // Quantity controls
  function incrementQuantity() {
    const input = document.getElementById('quantity');
    input.value = parseInt(input.value) + 1;
  }

  function decrementQuantity() {
    const input = document.getElementById('quantity');
    if (parseInt(input.value) > 1) {
      input.value = parseInt(input.value) - 1;
    }
  }

  // Buy Now functionality
  async function buyNow() {
    const form = document.getElementById('product-form');
    const formData = new FormData(form);

    try {
      // Add to cart
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        // Redirect to checkout
        window.location.href = '/checkout';
      }
    } catch (error) {
      console.error('Error:', error);
      alert('Something went wrong. Please try again.');
    }
  }

  // Handle add to cart
  document.getElementById('product-form').addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn = document.getElementById('add-to-cart-btn');
    const originalText = btn.innerHTML;

    btn.innerHTML = '<span style="display: inline-block; width: 1.5rem; height: 1.5rem; border: 3px solid #000000; border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite;"></span>';
    btn.disabled = true;

    try {
      const formData = new FormData(this);
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        // Update cart count
        const cartResponse = await fetch('/cart.js');
        const cart = await cartResponse.json();

        document.querySelectorAll('[x-text="cartCount"]').forEach(el => {
          el.textContent = cart.item_count;
        });

        // Show success
        btn.innerHTML = '✓ Added to Cart!';
        btn.style.backgroundColor = '#00d4ff';

        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.style.backgroundColor = '#ffffff';
          btn.disabled = false;
        }, 2000);
      }
    } catch (error) {
      console.error('Error:', error);
      btn.innerHTML = 'Error - Try Again';

      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 2000);
    }
  });
</script>

{% schema %}
{
  "name": "Product Main",
  "settings": []
}
{% endschema %}
