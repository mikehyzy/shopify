{% comment %}
  Cart Template
{% endcomment %}

<div class="cart-page section bg-midnight">
  <div class="container-custom max-w-4xl">

    <h1 class="text-hero font-heading font-bold mb-8 text-center">
      Your Cart
    </h1>

    {% if cart.item_count > 0 %}

      <!-- Cart Items -->
      <form action="/cart" method="post" class="mb-8">

        <div class="space-y-6 mb-8">
          {% for item in cart.items %}
            <div class="cart-item card p-6 flex items-center gap-6">

              <!-- Product Image -->
              {% if item.image %}
                <a href="{{ item.url }}" class="flex-shrink-0">
                  <img src="{{ item.image | image_url: width: 150 }}"
                       alt="{{ item.title }}"
                       class="w-24 h-24 object-cover rounded-lg">
                </a>
              {% endif %}

              <!-- Product Info -->
              <div class="flex-1">
                <h3 class="font-heading font-bold text-lg mb-2">
                  <a href="{{ item.url }}" class="hover:text-brass transition-colors">
                    {{ item.product.title }}
                  </a>
                </h3>

                {% unless item.variant.title contains 'Default' %}
                  <p class="text-sm text-chicago-grey mb-2">
                    {{ item.variant.title }}
                  </p>
                {% endunless %}

                <p class="text-brass font-heading font-semibold">
                  {{ item.final_price | money }}
                </p>
              </div>

              <!-- Quantity -->
              <div class="flex items-center gap-4">
                <label for="updates_{{ item.key }}" class="sr-only">Quantity</label>
                <input type="number"
                       name="updates[]"
                       id="updates_{{ item.key }}"
                       value="{{ item.quantity }}"
                       min="0"
                       class="form-input w-20 text-center">
              </div>

              <!-- Line Total -->
              <div class="text-right">
                <p class="font-heading font-bold text-xl">
                  {{ item.final_line_price | money }}
                </p>
              </div>

              <!-- Remove -->
              <a href="/cart/change?line={{ forloop.index }}&quantity=0"
                 class="text-chicago-grey hover:text-electric transition-colors"
                 aria-label="Remove {{ item.title }}">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </a>
            </div>
          {% endfor %}
        </div>

        <!-- Cart Note -->
        <div class="mb-8">
          <label for="note" class="form-label">Order Notes (Optional)</label>
          <textarea name="note"
                    id="note"
                    class="form-input"
                    rows="3"
                    placeholder="Special instructions or gift message">{{ cart.note }}</textarea>
        </div>

        <!-- Update Cart Button -->
        <div class="text-center mb-8">
          <button type="submit" name="update" class="btn btn-secondary">
            Update Cart
          </button>
        </div>
      </form>

      <!-- Cart Summary -->
      <div class="card p-8">
        <div class="space-y-4 mb-6">
          <div class="flex justify-between text-lg">
            <span class="text-chicago-grey">Subtotal</span>
            <span class="font-heading font-bold">{{ cart.total_price | money }}</span>
          </div>

          <p class="text-sm text-chicago-grey">
            Shipping and taxes calculated at checkout
          </p>
        </div>

        <a href="/checkout" class="btn btn-primary w-full mb-4">
          Proceed to Checkout
        </a>

        <a href="/collections/all" class="block text-center text-electric hover:underline">
          Continue Shopping
        </a>
      </div>

    {% else %}

      <!-- Empty Cart -->
      <div class="text-center py-16">
        <svg class="w-24 h-24 mx-auto mb-6 text-chicago-grey" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>

        <h2 class="text-2xl font-heading font-bold mb-4">
          Your cart is empty
        </h2>

        <p class="text-chicago-grey mb-8">
          Looks like you haven't added any games to your cart yet.
        </p>

        <a href="/collections/all" class="btn btn-primary">
          Explore Games
        </a>
      </div>

    {% endif %}
  </div>
</div>
