{% comment %}
  404 Page Not Found Template
{% endcomment %}

<div class="error-404 section bg-midnight min-h-screen flex items-center justify-center">
  <div class="container-custom text-center">

    <!-- 404 Illustration -->
    <div class="mb-8">
      <h1 class="text-9xl font-heading font-bold gradient-text mb-4">
        404
      </h1>
    </div>

    <!-- Error Message -->
    <h2 class="text-4xl font-heading font-bold mb-6">
      Page Not Found
    </h2>

    <p class="text-xl text-chicago-grey mb-8 max-w-2xl mx-auto">
      The page you're looking for has drifted into an alternate future. Let's get you back on track.
    </p>

    <!-- Navigation Options -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a href="/" class="btn btn-primary">
        Return Home
      </a>
      <a href="/collections/all" class="btn btn-secondary">
        Browse Games
      </a>
    </div>

    <!-- Quote -->
    <blockquote class="max-w-2xl mx-auto border-l-4 border-brass pl-6">
      <p class="font-accent text-xl text-electric italic">
        "Not all who wander are lost, but this page certainly is."
      </p>
    </blockquote>
  </div>
</div>
