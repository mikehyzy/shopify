<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0a0a0a">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- unless settings.type_header_font.system? -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {%- endunless -%}

  {%- liquid
    assign page_title = page_title | default: shop.name
    assign page_description = page_description | default: shop.description
  -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'meta-tags' %}

  <!-- Preload critical assets -->
  <link rel="preload" href="{{ 'theme.css' | asset_url }}" as="style">
  <link rel="preload" href="{{ 'main.js' | asset_url }}" as="script">

  <!-- Critical CSS -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Dancing+Script:wght@400;700&display=swap" rel="stylesheet">

  <!-- GSAP from CDN -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/TextPlugin.min.js" defer></script>

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- React from CDN -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>

  <!-- Theme JavaScript -->
  {{ 'main.js' | asset_url | script_tag }}
  {{ 'animations.js' | asset_url | script_tag }}

  {{ content_for_header }}

  <script>
    // Dark mode is default for this theme
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');

    // Store configuration
    window.theme = {
      routes: {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      },
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }}
      },
      moneyFormat: {{ shop.money_format | json }},
      settings: {
        animationsEnabled: {{ settings.enable_animations | default: true }},
        customCursor: {{ settings.enable_custom_cursor | default: true }}
      }
    };

    // Console Easter Egg
    console.log('%c🎭 Welcome to the Chicago Futures Salon', 'color: #d4af37; font-size: 24px; font-weight: bold;');
    console.log('%c"The marvelous is always beautiful, anything marvelous is beautiful, in fact only the marvelous is beautiful." - André Breton', 'color: #00d4ff; font-size: 14px; font-style: italic;');
  </script>

  {% render 'structured-data' %}
</head>

<body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}">
  <!-- Skip to content link for accessibility -->
  <a class="skip-to-content-link sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-brass focus:text-midnight" href="#MainContent">
    Skip to content
  </a>

  <!-- Custom cursor elements -->
  <div class="cursor-dot" id="cursor-dot"></div>
  <div class="cursor-outline" id="cursor-outline"></div>

  {% sections 'header-group' %}

  <!-- Main content -->
  <main id="MainContent" class="content-for-layout focus:outline-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <!-- React mount points for dynamic components -->
  <div id="react-portal"></div>
  <div id="modal-root"></div>

  <!-- Loading indicator -->
  <div id="page-loader" class="fixed inset-0 bg-midnight z-50 flex items-center justify-center transition-opacity duration-500 opacity-0 pointer-events-none">
    <div class="spinner"></div>
  </div>

  <!-- Announcement bar for special events (hidden by default) -->
  {% if settings.announcement_bar_enabled %}
    <div class="fixed bottom-0 left-0 right-0 bg-brass text-midnight text-center py-3 px-4 z-40 transform translate-y-full transition-transform duration-500" id="announcement-bar">
      <p class="text-sm font-heading uppercase tracking-wider">
        {{ settings.announcement_text | default: "Next salon event: Check the Events page" }}
      </p>
      <button class="absolute right-4 top-1/2 -translate-y-1/2 hover:opacity-70" onclick="this.parentElement.style.display='none'" aria-label="Close announcement">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 8.586L2.929 1.515 1.515 2.929 8.586 10l-7.071 7.071 1.414 1.414L10 11.414l7.071 7.071 1.414-1.414L11.414 10l7.071-7.071-1.414-1.414L10 8.586z"/>
        </svg>
      </button>
    </div>
  {% endif %}

  <!-- Accessibility: Screen reader announcements -->
  <div class="sr-only" role="status" aria-live="polite" aria-atomic="true" id="a11y-announcer"></div>

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script>
    // Initialize animations on page load
    window.addEventListener('DOMContentLoaded', (event) => {
      // Initialize custom cursor if enabled
      if (window.theme.settings.customCursor && window.innerWidth > 768) {
        const cursorDot = document.getElementById('cursor-dot');
        const cursorOutline = document.getElementById('cursor-outline');

        document.addEventListener('mousemove', (e) => {
          cursorDot.style.left = e.clientX + 'px';
          cursorDot.style.top = e.clientY + 'px';

          cursorOutline.style.left = e.clientX + 'px';
          cursorOutline.style.top = e.clientY + 'px';
        });

        // Magnetic effect on buttons
        document.querySelectorAll('.btn, a').forEach(el => {
          el.addEventListener('mouseenter', () => {
            cursorOutline.style.transform = 'translate(-50%, -50%) scale(1.5)';
          });
          el.addEventListener('mouseleave', () => {
            cursorOutline.style.transform = 'translate(-50%, -50%) scale(1)';
          });
        });
      }

      // Konami code easter egg
      let konamiCode = [];
      const konamiSequence = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];

      document.addEventListener('keydown', (e) => {
        konamiCode.push(e.key);
        konamiCode = konamiCode.slice(-10);

        if (konamiCode.join(',') === konamiSequence.join(',')) {
          console.log('%c🎉 You found the secret! "Futures are not predicted, they are imagined."', 'color: #9b4dca; font-size: 20px; font-weight: bold;');
          document.body.style.animation = 'pulse-slow 2s ease-in-out';
          setTimeout(() => {
            document.body.style.animation = '';
          }, 2000);
        }
      });
    });
  </script>
</body>
</html>
